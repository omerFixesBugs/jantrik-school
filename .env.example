# Copy to .env (never commit .env). All apps/packages read this single root file.
# Dates are stored in UTC; the UI displays them in Asia/Dhaka.

# --- Postgres (docker-compose) ---
# Superuser: used only by the Docker init script (docker/postgres/init) to create roles + DBs.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Passwords for the application roles created by the init script.
#   jantrik_owner:        owns the schema, runs migrations + template seed
#   jantrik_app:          runtime role, NOSUPERUSER NOBYPASSRLS, subject to Row-Level Security
#   jantrik_platform_app: the API's platform module only (Jantrik's own admins); the only role
#                         that may run the platform_* functions
DB_OWNER_PASSWORD=owner_dev_password
DB_APP_PASSWORD=app_dev_password
# Password of jantrik_platform_app (the API platform module's role), set by the init script.
DB_PLATFORM_PASSWORD=platform_dev_password

# Runtime connection (API, seed of tenant data): the RLS-restricted app role.
DATABASE_URL=postgresql://jantrik_app:app_dev_password@localhost:5432/jantrik
# Migrations (prisma migrate) and template seeding: the owner role.
DATABASE_MIGRATION_URL=postgresql://jantrik_owner:owner_dev_password@localhost:5432/jantrik
# The API's platform module (/platform): its own login, same database. API, DB and Playwright
# tests use this user and password on the database of DATABASE_URL_TEST / DATABASE_URL_E2E.
DATABASE_PLATFORM_URL=postgresql://jantrik_platform_app:platform_dev_password@localhost:5432/jantrik

# Integration tests (packages/db) use a separate database.
DATABASE_URL_TEST=postgresql://jantrik_app:app_dev_password@localhost:5432/jantrik_test
DATABASE_MIGRATION_URL_TEST=postgresql://jantrik_owner:owner_dev_password@localhost:5432/jantrik_test

# Playwright end-to-end tests (apps/web/e2e) use their own seeded database and Redis DB 2.
DATABASE_URL_E2E=postgresql://jantrik_app:app_dev_password@localhost:5432/jantrik_e2e
DATABASE_MIGRATION_URL_E2E=postgresql://jantrik_owner:owner_dev_password@localhost:5432/jantrik_e2e
REDIS_URL_E2E=redis://localhost:6379/2

# --- Redis (docker-compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# API e2e tests use a separate Redis database (flushed by the test setup).
REDIS_URL_TEST=redis://localhost:6379/1

# --- API (apps/api) ---
API_PORT=4000
# Browser origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:3000
# Express "trust proxy": false locally; e.g. 1 behind one reverse proxy.
TRUST_PROXY=false

# --- Auth (apps/api) --- generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
OTP_PEPPER=dev-only-otp-pepper-change-me-0123456789abcdefgh
# Platform admins' 2FA: encrypts their TOTP secrets (required in production, at least 32
# characters; development derives one from OTP_PEPPER when unset). Changing it means every
# platform admin re-enrols (pnpm platform:admin reset-2fa).
# PLATFORM_TOTP_KEY=
# Secure flag on the refresh cookie (browsers accept it on http://localhost). Must be true in
# production (the API refuses to start otherwise).
COOKIE_SECURE=true
# Development only: open the dev app from a phone on the same Wi-Fi (http://<PC's LAN IP>:3000).
# Allows CORS from private LAN addresses and sends the refresh cookie without Secure over plain
# http. The API refuses to start with this set outside NODE_ENV=development. See README.
DEV_LAN=false
# console = print SMS (incl. OTP codes) to the API log. Development only.
SMS_PROVIDER=console
# Optional rate-limit overrides (defaults shown). Per-IP limits are high on purpose:
# many users share one IP behind carrier CGNAT or school Wi-Fi.
# RATE_LIMIT_USER_PER_MIN=300
# RATE_LIMIT_IP_PER_MIN=600
# OTP_REQUEST_PER_IP_PER_HOUR=200
# OTP_PER_PHONE_COOLDOWN_SEC=60
# OTP_PER_PHONE_PER_15MIN=5
# OTP_PER_PHONE_PER_DAY=10
# LOGIN_PER_IP_PER_15MIN=300
# LOGIN_PER_IDENTIFIER_PER_15MIN=5

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
