# Copy to .env (never commit .env). All apps/packages read this single root file.
# Dates are stored in UTC; the UI displays them in Asia/Dhaka.

# --- Postgres (docker-compose) ---
# Superuser: used only by the Docker init script (docker/postgres/init) to create roles + DBs.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Passwords for the application roles created by the init script.
#   jantrik_owner:        owns the schema, runs migrations + template seed
#   jantrik_app:          runtime role, NOSUPERUSER NOBYPASSRLS, subject to Row-Level Security
#   jantrik_platform_app: the API's platform module only (Jantrik's own admins); the only role
#                         that may run the platform_* functions
#   jantrik_ingest_app:   the device (ZKTeco) receiver only; the only role that may run the
#                         ingest_* functions
#   jantrik_login_app:    the password login only; the only role that may look up a password
#                         hash (auth_find_user_for_password_login)
DB_OWNER_PASSWORD=owner_dev_password
DB_APP_PASSWORD=app_dev_password
# Password of jantrik_platform_app (the API platform module's role), set by the init script.
DB_PLATFORM_PASSWORD=platform_dev_password
# Password of jantrik_ingest_app (the device receiver's role), set by the init script.
DB_INGEST_PASSWORD=ingest_dev_password
# Password of jantrik_login_app (the password login's role), set by the init script.
DB_LOGIN_PASSWORD=login_dev_password

# Runtime connection (API, seed of tenant data): the RLS-restricted app role.
DATABASE_URL=postgresql://jantrik_app:app_dev_password@localhost:5432/jantrik
# Migrations (prisma migrate) and template seeding: the owner role.
DATABASE_MIGRATION_URL=postgresql://jantrik_owner:owner_dev_password@localhost:5432/jantrik
# The API's platform module (/platform): its own login, same database. API, DB and Playwright
# tests use this user and password on the database of DATABASE_URL_TEST / DATABASE_URL_E2E.
DATABASE_PLATFORM_URL=postgresql://jantrik_platform_app:platform_dev_password@localhost:5432/jantrik
# The device receiver (ZKTeco attendance machines): its own login, same database. Tests use this
# user and password on the test / e2e database.
DATABASE_INGEST_URL=postgresql://jantrik_ingest_app:ingest_dev_password@localhost:5432/jantrik
# The password login (POST /auth/login with a password): its own login, same database, the only
# one that may read a password hash. Tests use this user and password on the test / e2e database.
DATABASE_LOGIN_URL=postgresql://jantrik_login_app:login_dev_password@localhost:5432/jantrik

# Integration tests (packages/db) use a separate database.
DATABASE_URL_TEST=postgresql://jantrik_app:app_dev_password@localhost:5432/jantrik_test
DATABASE_MIGRATION_URL_TEST=postgresql://jantrik_owner:owner_dev_password@localhost:5432/jantrik_test
# The login privilege tests create roles as the superuser. Optional locally: without it they use
# POSTGRES_USER and POSTGRES_PASSWORD above on the test database.
# DATABASE_SUPERUSER_URL_TEST=postgresql://postgres:postgres@localhost:5432/jantrik_test

# Playwright end-to-end tests (apps/web/e2e) use their own seeded database and Redis DB 2.
DATABASE_URL_E2E=postgresql://jantrik_app:app_dev_password@localhost:5432/jantrik_e2e
DATABASE_MIGRATION_URL_E2E=postgresql://jantrik_owner:owner_dev_password@localhost:5432/jantrik_e2e
REDIS_URL_E2E=redis://localhost:6379/2

# --- Redis (docker-compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# API e2e tests use a separate Redis database (flushed by the test setup).
REDIS_URL_TEST=redis://localhost:6379/1

# --- API (apps/api) ---
API_PORT=4000
# Browser origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:3000
# The platform web app's origins: the only ones /platform/* answers (each also in CORS_ORIGINS).
# Required in production (https://platform.<domain>); this default suits development only.
# PLATFORM_ORIGINS=http://localhost:3000
# Express "trust proxy": false locally; e.g. 1 behind one reverse proxy.
TRUST_PROXY=false

# --- Auth (apps/api) --- generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
OTP_PEPPER=dev-only-otp-pepper-change-me-0123456789abcdefgh
# Platform admins' 2FA: encrypts their TOTP secrets (required in production, at least 32
# characters; development derives one from OTP_PEPPER when unset). Changing it means every
# platform admin re-enrols (pnpm platform:admin reset-2fa).
# PLATFORM_TOTP_KEY=
# Secure flag on the refresh cookie (browsers accept it on http://localhost). Must be true in
# production (the API refuses to start otherwise).
COOKIE_SECURE=true
# Development only: open the dev app from a phone on the same Wi-Fi (http://<PC's LAN IP>:3000).
# Allows CORS from private LAN addresses and sends the refresh cookie without Secure over plain
# http. The API refuses to start with this set outside NODE_ENV=development. See README.
DEV_LAN=false
# console = print SMS (incl. OTP codes) to the API log. Development only. Production refuses it
# (and memory, outbox); none = no gateway yet, every SMS fails (docs/deploy.md).
SMS_PROVIDER=console

# --- Online admission: the public form (sprint 1 P3b, docs/admission.md) ---
# Cloudflare Turnstile. These two are Cloudflare's published TEST keys (they always pass, and the
# widget says it is for testing): fine for development, refused by the API in production. For
# production, make a free widget for your web domain at dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Admission codes per institute per day, whatever the phones and addresses (default 300): all of
# them, the status page's a fifth (60) and the form's the rest (240).
# ADMISSION_OTP_PER_TENANT_PER_DAY=300
# The web app's public address: the status link in the "application received" SMS, and where a
# guardian's browser comes back to from SSLCommerz (online payments need it). Optional in
# development, required in production.
# WEB_PUBLIC_URL=http://localhost:3000
# --- Online fee payments: SSLCommerz, sandbox only (sprint 1 P7a, docs/payments.md) ---
# Encrypts each institute's SSLCommerz store ID and password. Required in production (at least 32
# characters, its own value: openssl rand -base64 48); development and tests derive one from
# OTP_PEPPER when unset. Changing it makes every saved store unreadable: each owner enters the
# credentials again.
# PAYMENT_CREDENTIALS_KEY=
# The API's public address: the base of the return and IPN addresses SSLCommerz is given
# (scheme, host and port only). Optional; an institute cannot turn online payments on without it.
# SSLCommerz cannot reach localhost, so locally a payment completes through the payer's return.
# API_PUBLIC_URL=http://localhost:4000
# Your own SSLCommerz sandbox store (https://sandbox-gw.sslcommerz.com/register), for the two
# development commands only: pnpm --filter @jantrik/api payments:sandbox-smoke and
# payments:load-sandbox. Production refuses both. Never put a live store here.
# SSLCOMMERZ_SANDBOX_STORE_ID=
# SSLCOMMERZ_SANDBOX_STORE_PASSWORD=
# Development and tests only: a fake SSLCommerz on this machine instead of the sandbox
# (pnpm --filter @jantrik/api payments:fake listens on 4090). Production refuses it.
# SSLCOMMERZ_BASE_URL=http://127.0.0.1:4090
# Process the queue jobs in the API (default). false only next to a separate worker process
# (node apps/api/dist/worker-main.js), as the production compose runs it.
# QUEUE_WORKERS=true
# Optional rate-limit overrides (defaults shown). Per-IP limits are high on purpose:
# many users share one IP behind carrier CGNAT or school Wi-Fi.
# RATE_LIMIT_USER_PER_MIN=300
# RATE_LIMIT_IP_PER_MIN=600
# OTP_REQUEST_PER_IP_PER_HOUR=200
# OTP_PER_PHONE_COOLDOWN_SEC=60
# OTP_PER_PHONE_PER_15MIN=5
# OTP_PER_PHONE_PER_DAY=10
# LOGIN_PER_IP_PER_15MIN=300
# LOGIN_PER_IDENTIFIER_PER_15MIN=5

# Device receiver (ZKTeco attendance machines), optional (defaults shown). INGEST_IN_PROCESS runs
# it inside the API (default outside production); in production it is its own process
# (dist/ingest-main.js) given only NODE_ENV, DATABASE_INGEST_URL, REDIS_URL, QUEUE_PREFIX,
# INGEST_PORT, INGEST_TRUST_PROXY and the limits below, never the API's logins or secrets. The
# public host and port are the API's: what admins read in the device setup guide. The host is
# required in production (not localhost or 0.0.0.0).
# INGEST_IN_PROCESS=true
# INGEST_PORT=4080
# INGEST_PUBLIC_HOST=localhost
# INGEST_PUBLIC_PORT=4080
# INGEST_TRUST_PROXY=false
# INGEST_PER_IP_PER_MIN=1200
# INGEST_PER_DEVICE_PER_MIN=300
# INGEST_PER_DEVICE_ALL_PER_MIN=1200
# INGEST_REFUSED_PER_IP_PER_10MIN=30
# INGEST_MAX_ATTLOG_BYTES=524288
# INGEST_MAX_DRAIN_BYTES=2097152

# Stored images (photos, logos, signatures, seals) per institute, in MB (docs/files.md). Over it,
# uploads are refused with 413 STORAGE_FULL. Optional (default shown).
# FILE_STORAGE_PER_TENANT_MB=1024

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# The boot refresh (docs/auth.md → Web client): on unless `off`. Read per request, no rebuild.
# JANTRIK_BOOT_REFRESH=off
