# Copy to .env (never commit .env). All apps/packages read this single root file.
# Dates are stored in UTC; the UI displays them in Asia/Dhaka.

# --- Postgres (docker-compose) ---
POSTGRES_USER=jantrik
POSTGRES_PASSWORD=jantrik
POSTGRES_DB=jantrik
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jantrik:jantrik@localhost:5432/jantrik?schema=public

# --- Redis (docker-compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ---
API_PORT=4000
# Allowed CORS origin (the web app)
WEB_URL=http://localhost:3000

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
