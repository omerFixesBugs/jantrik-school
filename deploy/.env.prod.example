# Production settings for deploy/docker-compose.prod.yml (docs/deploy.md).
#   cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
# then replace every value. deploy/.env.prod is git-ignored: never commit it, keep a copy in your
# password manager. The services refuse to start with these example values.
#
#   secrets:   openssl rand -base64 48 | tr -d '\n'
#   passwords: openssl rand -hex 24      (letters and digits only: they go into URLs as they are)

# --- Domains (each an A record pointing at this server; no AAAA record yet: docs/deploy.md) ---
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Jantrik's own admins (the /platform pages), on their own subdomain.
PLATFORM_DOMAIN=platform.example.com
# What attendance devices dial (port 4080, plain HTTP): a domain or the server's fixed IP address.
DEVICE_HOST=device.example.com
# Let's Encrypt writes here about certificates that are about to expire.
ACME_EMAIL=ops@example.com

# --- Postgres ---
# The superuser: the roles script, backups and restores. No app ever logs in with it.
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
# The roles' passwords (deploy/postgres/create-roles.sh), set on the database's first start only.
# Changing them later means ALTER ROLE ... PASSWORD as well (docs/deploy.md).
DB_OWNER_PASSWORD=CHANGE_ME_openssl_rand_hex_24
DB_APP_PASSWORD=CHANGE_ME_openssl_rand_hex_24
DB_PLATFORM_PASSWORD=CHANGE_ME_openssl_rand_hex_24
DB_INGEST_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB_NAME=jantrik

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_24
# Redis refuses writes beyond this (it never evicts a key). About an eighth of the server's memory
# to start (512mb on 4 GB); watch it (docs/deploy.md → Monitoring) and raise it before it fills.
REDIS_MAXMEMORY=512mb

# --- API secrets (at least 32 characters, all different) ---
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48
OTP_PEPPER=CHANGE_ME_openssl_rand_base64_48
# Encrypts the platform admins' 2FA secrets. Changing it means every admin runs reset-2fa.
PLATFORM_TOTP_KEY=CHANGE_ME_openssl_rand_base64_48

# --- API ---
# No SMS gateway is built yet: every SMS fails (and is recorded as failed). Until one exists no
# institute user can sign in (logins need an OTP); only platform admins can. A go-live blocker.
SMS_PROVIDER=none
# Proxies in front of the API: 1 (Caddy). Never true.
TRUST_PROXY=1
# BullMQ key prefix in Redis.
QUEUE_PREFIX=jantrik

# --- Device receiver ---
# Devices connect directly: the receiver trusts no X-Forwarded-For (fixed in the compose file).
# The port devices dial (shown in the device setup guide) and the one published on the server.
INGEST_PUBLIC_PORT=4080
INGEST_HOST_PORT=4080
INGEST_BIND=0.0.0.0

# --- Ports on the server itself (127.0.0.1 only; Caddy serves the public HTTPS) ---
API_HOST_PORT=4000
WEB_HOST_PORT=3000

# --- Images and backups ---
# The tag the built images get (e.g. the git commit you deployed).
IMAGE_TAG=local
# Where backups go on the server: outside the git checkout, created first and owned by the
# deploy user (docs/deploy.md → Backups), whose ids (id -u, id -g) the backup runs as.
BACKUP_HOST_DIR=/srv/jantrik-backups
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_KEEP_DAYS=14
