{
  "name": "@jantrik/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@jantrik/eslint-config": "workspace:*",
    "@jantrik/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "prisma": "7.10.1",
    "typescript": "6.0.3"
  }
}
