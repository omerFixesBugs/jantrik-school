// ───────────────────────────── Academic structure ─────────────────────────────

model GradingScheme {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  nameBn             String       @map("name_bn")
  nameEn             String       @map("name_en")
  roundingMode       RoundingMode @default(NONE) @map("rounding_mode")
  /// GPA rules (data, not code): the cap, the 4th subject's bonus threshold (NULL: no bonus),
  /// how the GPA is cut, and whether one failed compulsory subject makes the GPA 0.
  gpaMax             Decimal      @default(5.00) @map("gpa_max") @db.Decimal(3, 2)
  optionalBonusAbove Decimal?     @default(2.00) @map("optional_bonus_above") @db.Decimal(3, 2)
  gpaDecimals        Int          @default(2) @map("gpa_decimals") @db.SmallInt
  gpaRounding        GpaRounding  @default(TRUNCATE) @map("gpa_rounding")
  compulsoryFailZero Boolean      @default(true) @map("compulsory_fail_zero")
  isDefault          Boolean      @default(false) @map("is_default")
  sourceTemplateId   String?      @map("source_template_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceTemplate GradingSchemeTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  bands          GradeBand[]
  classLevels    ClassLevel[]

  @@unique([tenantId, id])
  @@unique([tenantId], map: "grading_schemes_one_default_per_tenant", where: raw("is_default"))
  @@map("grading_schemes")
}

model GradeBand {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  gradingSchemeId String   @map("grading_scheme_id") @db.Uuid
  /// Inclusive lower bound. A percentage gets the band with the highest min_percent <= it.
  minPercent      Decimal  @map("min_percent") @db.Decimal(5, 2)
  /// Informational upper bound shown to users (e.g. 70–79).
  maxPercent      Decimal  @map("max_percent") @db.Decimal(5, 2)
  letter          String
  gradePoint      Decimal  @map("grade_point") @db.Decimal(3, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  gradingScheme GradingScheme @relation(fields: [tenantId, gradingSchemeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, gradingSchemeId, minPercent])
  @@unique([tenantId, gradingSchemeId, letter])
  @@map("grade_bands")
}

model ClassLevel {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  code             String
  nameBn           String   @map("name_bn")
  nameEn           String   @map("name_en")
  sortOrder        Int      @default(0) @map("sort_order")
  /// Overrides the tenant's default grading scheme for this class level.
  gradingSchemeId  String?  @map("grading_scheme_id") @db.Uuid
  sourceTemplateId String?  @map("source_template_id") @db.Uuid
  /// Deactivated instead of deleted once in use; hidden from pickers for new records.
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  gradingScheme    GradingScheme?       @relation(fields: [tenantId, gradingSchemeId], references: [tenantId, id], onDelete: Restrict)
  sourceTemplate   TemplateClassLevel?  @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  subjects         Subject[]
  sections         Section[]
  enrolments       Enrolment[]
  feeAmounts       FeeAmount[]
  examClasses      ExamClass[]
  noticeTargets    NoticeTarget[]
  broadcastTargets SmsBroadcastTarget[]

  admissionCycleClasses AdmissionCycleClass[]
  promotionRuns         PromotionRun[]
  promotionRowsTargets  PromotionRunStudent[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("class_levels")
}

model StudyGroup {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  code             String
  nameBn           String   @map("name_bn")
  nameEn           String   @map("name_en")
  sortOrder        Int      @default(0) @map("sort_order")
  sourceTemplateId String?  @map("source_template_id") @db.Uuid
  /// Deactivated instead of deleted once in use; hidden from pickers for new records.
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceTemplate TemplateStudyGroup? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  subjects       Subject[]
  enrolments     Enrolment[]
  feeAmounts     FeeAmount[]
  examSubjects   ExamSubject[]
  examCandidates ExamCandidate[]

  admissionCycleClasses AdmissionCycleClass[]
  promotionRowsTargets  PromotionRunStudent[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("study_groups")
}

model Subject {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  classLevelId     String   @map("class_level_id") @db.Uuid
  studyGroupId     String?  @map("study_group_id") @db.Uuid
  code             String
  nameBn           String   @map("name_bn")
  nameEn           String   @map("name_en")
  /// In the class's elective pool: taken only when chosen per student (compulsory or as the
  /// 4th subject, student_subject_choices).
  isOptional       Boolean  @default(false) @map("is_optional")
  passRule         PassRule @default(PER_COMPONENT) @map("pass_rule")
  sortOrder        Int      @default(0) @map("sort_order")
  sourceTemplateId String?  @map("source_template_id") @db.Uuid
  /// Deactivated instead of deleted once in use; hidden from pickers for new records.
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  classLevel     ClassLevel       @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict)
  studyGroup     StudyGroup?      @relation(fields: [tenantId, studyGroupId], references: [tenantId, id], onDelete: Restrict)
  sourceTemplate TemplateSubject? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  attendanceSessions AttendanceSession[]
  components         SubjectComponent[]
  passGroups         SubjectPassGroup[]
  subjectTeachers    SectionSubjectTeacher[]
  choices            StudentSubjectChoice[]
  examSubjects       ExamSubject[]

  @@unique([tenantId, id])
  /// So rows can carry the class level and be checked against a section's class.
  @@unique([tenantId, id, classLevelId])
  @@unique([tenantId, classLevelId, code])
  @@map("subjects")
}

/// A section (school) or batch (coaching) of a class level in one academic year.
model Section {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classLevelId   String   @map("class_level_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  shiftId        String?  @map("shift_id") @db.Uuid
  name           String
  capacity       Int?
  sortOrder      Int      @default(0) @map("sort_order")
  /// Deactivated instead of deleted once in use; hidden from pickers for new records.
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  classLevel   ClassLevel   @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  shift        Shift?       @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)
  enrolments   Enrolment[]

  teachers           SectionTeacher[]
  attendanceSessions AttendanceSession[]
  subjectTeachers    SectionSubjectTeacher[]
  examCandidates     ExamCandidate[]
  examMarkSheets     ExamMarkSheet[]
  examResults        ExamResult[]
  noticeTargets      NoticeTarget[]
  broadcastTargets   SmsBroadcastTarget[]

  promotionRowsFrom    PromotionRunStudent[] @relation("PromotionRowFromSection")
  promotionRowsTargets PromotionRunStudent[] @relation("PromotionRowTargetSection")

  @@unique([tenantId, id])
  /// So rows can carry the class level and be checked against a subject's class.
  @@unique([tenantId, id, classLevelId])
  /// So a promotion row's target section can be checked against its year and class (P5).
  @@unique([tenantId, id, academicYearId, classLevelId])
  @@unique([tenantId, academicYearId, classLevelId, name])
  @@index([tenantId, classLevelId])
  @@map("sections")
}

// ───────────────────────────── People in a tenant ─────────────────────────────

model Membership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      Role
  status    MembershipStatus @default(ACTIVE)
  /// When the (latest) invitation was sent; INVITED rows older than 14 days have expired.
  invitedAt DateTime?        @map("invited_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, role])
  @@index([tenantId, role])
  @@index([userId])
  @@map("memberships")
}

model Student {
  id                   String         @id @default(uuid(7)) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  studentCode          String         @map("student_code")
  userId               String?        @map("user_id") @db.Uuid
  nameBn               String?        @map("name_bn")
  nameEn               String?        @map("name_en")
  dateOfBirth          DateTime?      @map("date_of_birth") @db.Date
  gender               Gender?
  /// The student's photo (stored_files, kind STUDENT_PHOTO); replaced files are deleted.
  photoFileId          String?        @map("photo_file_id") @db.Uuid
  /// Always STUDENT_PHOTO (CHECK): part of the foreign key, so the photo can only be a photo.
  photoFileKind        StoredFileKind @default(STUDENT_PHOTO) @map("photo_file_kind")
  status               StudentStatus  @default(ACTIVE)
  /// The day a leaver left (GRADUATED, TRANSFERRED, DROPPED_OUT, INACTIVE without deletion);
  /// NULL while the student stays (P5, S14).
  leftOn               DateTime?      @map("left_on") @db.Date
  leaveReason          String?        @map("leave_reason")
  // Fields required for Bangladesh education board registration.
  fatherNameBn         String?        @map("father_name_bn")
  fatherNameEn         String?        @map("father_name_en")
  motherNameBn         String?        @map("mother_name_bn")
  motherNameEn         String?        @map("mother_name_en")
  religion             Religion?
  /// 17-digit birth registration number; unique per tenant when present.
  birthRegistrationNo  String?        @map("birth_registration_no")
  bloodGroup           BloodGroup?    @map("blood_group")
  presentAddress       String?        @map("present_address")
  permanentAddress     String?        @map("permanent_address")
  /// The admission date dues count from when it is not the creation day: set only when a child
  /// is admitted into a year that has not started and is not current yet (that year's start,
  /// decision P3-K). NULL for everyone else.
  admissionDateForDues DateTime?      @map("admission_date_for_dues") @db.Date
  /// Soft delete. Queries must filter `deletedAt: null` themselves.
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  photoFile  StoredFile?       @relation("StudentPhoto", fields: [tenantId, photoFileId, photoFileKind], references: [tenantId, id, kind], onDelete: Restrict, onUpdate: Restrict)
  guardians  StudentGuardian[]
  enrolments Enrolment[]

  attendanceRecords       AttendanceRecord[]
  feeConcessions          FeeConcession[]
  feeSiblingMembers       FeeSiblingMember[]
  feeDues                 FeeDue[]
  feeFineWaivers          FeeFineWaiver[]
  feePayments             FeePayment[]
  feePaymentAllocations   FeePaymentAllocation[]
  feeMobileSubmissions    FeeMobileSubmission[]
  feeMobileSubmissionDues FeeMobileSubmissionDue[]
  paymentIntents          PaymentIntent[]
  paymentIntentDues       PaymentIntentDue[]
  examCandidates          ExamCandidate[]
  devicePeople            DevicePerson[]
  admissionApplication    AdmissionApplication?
  promotionRows           PromotionRunStudent[]

  @@unique([tenantId, id])
  @@unique([tenantId, studentCode])
  @@unique([tenantId, birthRegistrationNo])
  // A file belongs to one student (also the foreign key's index).
  @@unique([tenantId, photoFileId, photoFileKind])
  @@index([tenantId, status], where: raw("deleted_at IS NULL"))
  @@index([tenantId, nameEn])
  // Trigram indexes for ILIKE '%…%' search (GET /students).
  @@index([nameBn(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_name_bn_trgm_idx")
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_name_en_trgm_idx")
  @@index([studentCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_student_code_trgm_idx")
  @@map("students")
}

model Guardian {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Set when the guardian logs in to the app (phone OTP).
  userId     String?  @map("user_id") @db.Uuid
  nameBn     String?  @map("name_bn")
  nameEn     String?  @map("name_en")
  /// E.164 Bangladeshi mobile; used for SMS notifications.
  phone      String
  email      String?
  occupation String?
  address    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@unique([tenantId, id])
  @@index([tenantId, phone])
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "guardians_phone_trgm_idx")
  @@map("guardians")
}

model StudentGuardian {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  guardianId String           @map("guardian_id") @db.Uuid
  relation   GuardianRelation
  isPrimary  Boolean          @default(false) @map("is_primary")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student  Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  guardian Guardian @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, studentId, guardianId])
  @@unique([tenantId, studentId], map: "student_guardians_one_primary_per_student", where: raw("is_primary"))
  @@index([tenantId, guardianId])
  @@map("student_guardians")
}

model Enrolment {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classLevelId   String   @map("class_level_id") @db.Uuid
  sectionId      String?  @map("section_id") @db.Uuid
  studyGroupId   String?  @map("study_group_id") @db.Uuid
  roll           Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  classLevel   ClassLevel   @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict)
  section      Section?     @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict)
  studyGroup   StudyGroup?  @relation(fields: [tenantId, studyGroupId], references: [tenantId, id], onDelete: Restrict)

  subjectChoices StudentSubjectChoice[]

  promotionRowsFrom PromotionRunStudent[] @relation("PromotionRowFromEnrolment")
  promotionRowsTo   PromotionRunStudent[] @relation("PromotionRowToEnrolment")

  @@unique([tenantId, id])
  /// So a promotion row's enrolments can be checked against its student (and its to-year).
  @@unique([tenantId, id, studentId])
  @@unique([tenantId, id, studentId, academicYearId])
  @@unique([tenantId, academicYearId, studentId])
  @@unique([tenantId, sectionId, roll])
  @@index([tenantId, academicYearId, classLevelId, sectionId])
  @@index([tenantId, studentId])
  @@map("enrolments")
}

/// The institute's theme, one row per tenant once the owner saves it; until then the institute
/// type's default theme and the preset's own accent (no backfill).
model AppearanceSettings {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @unique @map("tenant_id") @db.Uuid
  /// Null: the institute type's default (institute_types.default_theme).
  preset    ThemePreset?
  /// "#rrggbb" in lower case; null: the preset's own accent. The API checks its contrast.
  accent    String?      @db.Char(7)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("appearance_settings")
}

/// One row per tenant once an admin saves it; defaults live in code until then (no backfill).
model StudentSettings {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @unique @map("tenant_id") @db.Uuid
  /// 1–10 uppercase letters/digits, used by {PREFIX}.
  codePrefix  String   @map("code_prefix")
  /// Tokens: {PREFIX}, {YEAR}, {YY}, and one {N…} run (zero-padded sequence).
  codePattern String   @default("{PREFIX}-{YEAR}-{NNNN}") @map("code_pattern")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("student_settings")
}

/// Next student_code sequence number per tenant and year (atomic upsert ... RETURNING).
model StudentCodeCounter {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  year      Int
  nextValue Int      @map("next_value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, year])
  @@map("student_code_counters")
}

enum StudentImportStatus {
  UPLOADED
  VALIDATED
  QUEUED
  RUNNING
  DONE
  FAILED

  @@map("student_import_status")
}

/// One Excel/CSV student import. The raw rows (phones, birth registration numbers) are cleared
/// when it finishes or after 7 days unfinished; results keep row numbers, statuses and messages.
/// History: never deleted by the app.
model StudentImport {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  /// Plain FK: users are global. The service checks the uploader is OWNER/ADMIN here.
  createdById        String              @map("created_by_id") @db.Uuid
  status             StudentImportStatus @default(UPLOADED)
  fileName           String              @map("file_name")
  headers            Json                @db.JsonB
  /// string[][] data rows; NULL once cleared.
  rows               Json?               @db.JsonB
  mapping            Json?               @db.JsonB
  /// ImportRowResult[] (preview, then the outcome; kept as history, incl. who a possible duplicate looked like).
  results            Json?               @db.JsonB
  /// Rows flagged "possible duplicate" that the admin chose to import anyway (decision #22).
  duplicateOverrides Int[]               @default([]) @map("duplicate_overrides")
  rowCount           Int                 @map("row_count")
  processed          Int                 @default(0)
  failure            String?
  finishedAt         DateTime?           @map("finished_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("student_imports")
}

/// How this institute knows a staff member: the name and phone its admin typed. Shown instead
/// of the person's global name (which another institute, or the person, may have set).
model StaffProfile {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  /// Plain FK: users are global. The service only creates profiles with a staff membership.
  userId            String   @map("user_id") @db.Uuid
  name              String
  nameBn            String?  @map("name_bn")
  /// E.164, as typed (the person's own row is invisible to the institute while invited).
  phone             String
  /// Staff attendance. NULL: the default rule (tracked unless the person's only staff role here
  /// is OWNER), decided in code.
  attendanceTracked Boolean? @map("attendance_tracked")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  devicePeople   DevicePerson[]
  attendanceDays StaffAttendanceDay[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("staff_profiles")
}

// ───────────────────────────── Audit ─────────────────────────────

/// Append-only: the app role may only SELECT and INSERT.
model AuditLog {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  entity      String
  entityId    String      @map("entity_id") @db.Uuid
  action      AuditAction
  oldValues   Json?       @map("old_values") @db.JsonB
  newValues   Json?       @map("new_values") @db.JsonB
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUser User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ───────────────────────────── Attendance ─────────────────────────────
// Module ATTENDANCE. Dates are calendar dates in the tenant's timezone (tenants.timezone).

/// One row per tenant, created by provisionTenant() from the institute type's defaults.
model AttendanceSettings {
  id                    String         @id @default(uuid(7)) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  mode                  AttendanceMode @default(DAILY)
  /// ISO weekdays (1 = Monday … 7 = Sunday) with no attendance. Default: Friday.
  weeklyOffDays         Int[]          @default([5]) @map("weekly_off_days")
  /// How many days back a teacher may still take or change attendance (0 = same day only).
  editWindowDays        Int            @default(0) @map("edit_window_days") @db.SmallInt
  /// Present % normally leaves LEAVE out of the total; when true, LEAVE counts as absent.
  leaveCountsAsAbsent   Boolean        @default(false) @map("leave_counts_as_absent")
  absentSmsEnabled      Boolean        @default(false) @map("absent_sms_enabled")
  /// Variables: {student}, {date}, {institute}. Null = the built-in default template.
  absentSmsTemplate     String?        @map("absent_sms_template")
  /// Wait before sending, so a mis-tap corrected right away never reaches a guardian.
  absentSmsDelayMinutes Int            @default(10) @map("absent_sms_delay_minutes") @db.SmallInt
  /// Max SMS per day (tenant timezone). Null = 2 × active students.
  dailySmsCap           Int?           @map("daily_sms_cap")

  // Devices and staff attendance (step 11). DDL defaults, no backfill.
  /// Device punches write the register at the cutoff (DAILY mode).
  deviceAutoMark            Boolean  @default(false) @map("device_auto_mark")
  /// A first IN punch after shift start + grace is LATE.
  deviceGraceMinutes        Int      @default(10) @map("device_grace_minutes") @db.SmallInt
  /// The register is written at shift start + cutoff.
  deviceCutoffMinutes       Int      @default(60) @map("device_cutoff_minutes") @db.SmallInt
  /// "School starts at", for sections without a shift.
  deviceDefaultStart        DateTime @default(dbgenerated("'08:00:00'::time without time zone")) @map("device_default_start") @db.Time(0)
  entrySmsEnabled           Boolean  @default(false) @map("entry_sms_enabled")
  exitSmsEnabled            Boolean  @default(false) @map("exit_sms_enabled")
  staffOfficeStart          DateTime @default(dbgenerated("'08:00:00'::time without time zone")) @map("staff_office_start") @db.Time(0)
  staffOfficeEnd            DateTime @default(dbgenerated("'16:00:00'::time without time zone")) @map("staff_office_end") @db.Time(0)
  staffLateGraceMinutes     Int      @default(10) @map("staff_late_grace_minutes") @db.SmallInt
  staffEarlyGraceMinutes    Int      @default(10) @map("staff_early_grace_minutes") @db.SmallInt
  /// Punches outside these hours get the OUTSIDE_HOURS flag. The receiver reads them.
  deviceHoursStart          DateTime @default(dbgenerated("'05:00:00'::time without time zone")) @map("device_hours_start") @db.Time(0)
  deviceHoursEnd            DateTime @default(dbgenerated("'20:00:00'::time without time zone")) @map("device_hours_end") @db.Time(0)
  /// Per device and minute: punches over it are held (BURST), beyond 5 × it dropped.
  deviceMaxPunchesPerMinute Int      @default(60) @map("device_max_punches_per_minute") @db.SmallInt
  /// Staff default device IDs are taken from here up.
  staffDeviceIdStart        Int      @default(9001) @map("staff_device_id_start")
  /// Raw punches older than this are deleted (the database refuses within 30 days).
  punchRetentionDays        Int      @default(730) @map("punch_retention_days") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId])
  @@unique([tenantId, id])
  @@map("attendance_settings")
}

/// No attendance on these dates unless an admin overrides.
model Holiday {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  nameBn      String   @map("name_bn")
  nameEn      String   @map("name_en")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, startDate])
  @@map("holidays")
}

/// Teachers who may take attendance for a section (sections belong to one academic year).
model SectionTeacher {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  isClassTeacher Boolean  @default(false) @map("is_class_teacher")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  section Section @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, sectionId, userId])
  @@unique([tenantId, sectionId], map: "section_teachers_one_class_teacher", where: raw("is_class_teacher"))
  @@index([tenantId, userId])
  @@map("section_teachers")
}

// ───────────────────────────── Exams: setup (step 10) ─────────────────────────────

/// A subject's default exam part (CQ 70, MCQ 30, …), copied into each exam that covers it.
model SubjectComponent {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  subjectId        String        @map("subject_id") @db.Uuid
  key              String
  kind             ComponentKind
  nameBn           String        @map("name_bn")
  nameEn           String        @map("name_en")
  fullMarks        Int           @map("full_marks")
  /// Used when the subject's pass rule is PER_COMPONENT; NULL: this part has no pass mark.
  passMarks        Int?          @map("pass_marks")
  sortOrder        Int           @default(0) @map("sort_order")
  sourceTemplateId String?       @map("source_template_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subject        Subject                   @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Cascade)
  sourceTemplate TemplateSubjectComponent? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([tenantId, subjectId, key])
  @@map("subject_components")
}

/// Combined pass mark for one component kind of a subject (pass rule COMBINED): e.g. Bangla
/// 1st + 2nd paper CQ together need 46 of 140.
model SubjectPassGroup {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  subjectId String        @map("subject_id") @db.Uuid
  kind      ComponentKind
  passMarks Int           @map("pass_marks")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, subjectId, kind])
  @@map("subject_pass_groups")
}

/// A teacher who enters marks for one subject in one section. Both keys carry the class level,
/// so the subject must belong to the section's class.
model SectionSubjectTeacher {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sectionId    String   @map("section_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  classLevelId String   @map("class_level_id") @db.Uuid
  /// Global users table: the service checks for an ACTIVE staff membership in this tenant.
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // RESTRICT: a section or subject with subject teachers is "in use" (setup refuses to delete it).
  section Section @relation(fields: [tenantId, sectionId, classLevelId], references: [tenantId, id, classLevelId], onDelete: Restrict, onUpdate: Restrict)
  subject Subject @relation(fields: [tenantId, subjectId, classLevelId], references: [tenantId, id, classLevelId], onDelete: Restrict, onUpdate: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, sectionId, subjectId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, subjectId])
  @@map("section_subject_teachers")
}

/// A student's elective subject for one year (from subjects with is_optional): taken as
/// compulsory or as the 4th subject. Pool subjects without a choice are not taken.
model StudentSubjectChoice {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  academicYearId String            @map("academic_year_id") @db.Uuid
  studentId      String            @map("student_id") @db.Uuid
  subjectId      String            @map("subject_id") @db.Uuid
  kind           SubjectChoiceKind
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  enrolment Enrolment @relation(fields: [tenantId, academicYearId, studentId], references: [tenantId, academicYearId, studentId], onDelete: Cascade, onUpdate: Restrict)
  // RESTRICT: students' choices are records; a chosen subject is "in use".
  subject   Subject   @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, studentId, subjectId])
  @@unique([tenantId, academicYearId, studentId], map: "student_subject_choices_one_optional", where: raw("kind = 'OPTIONAL'::subject_choice_kind"))
  @@index([tenantId, subjectId])
  @@map("student_subject_choices")
}

/// An exam room (the institute's own list, reused by every exam's seat plan).
model ExamRoom {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// Benches front to back × seats across; at most 500 seats.
  rows      Int
  cols      Int
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  seats ExamCandidate[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("exam_rooms")
}

// ───────────────────────────── Exams: structure (step 10) ─────────────────────────────

/// An exam of an academic year (half-yearly, annual, class test, model test, …).
model Exam {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  academicYearId String             @map("academic_year_id") @db.Uuid
  kind           ExamKind
  nameBn         String             @map("name_bn")
  nameEn         String             @map("name_en")
  startsOn       DateTime           @map("starts_on") @db.Date
  endsOn         DateTime           @map("ends_on") @db.Date
  resultMode     ExamResultMode     @map("result_mode")
  /// Merit tie-breakers in order (GPA, TOTAL_MARKS, …, SUBJECT:<subjectId>, ROLL).
  meritOrder     String[]           @map("merit_order")
  failedRanking  MeritFailedRanking @map("failed_ranking")
  /// The days whose attendance the report card shows (both or neither).
  attendanceFrom DateTime?          @map("attendance_from") @db.Date
  attendanceTo   DateTime?          @map("attendance_to") @db.Date
  status         ExamStatus         @default(SETUP)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  classes    ExamClass[]
  candidates ExamCandidate[]

  promotionRuns PromotionRun[]

  @@unique([tenantId, id])
  /// So a promotion run's merit exam can be checked against its from-year (P5).
  @@unique([tenantId, id, academicYearId])
  @@index([tenantId, academicYearId, startsOn])
  @@map("exams")
}

/// A class an exam covers; its results are published (and versioned) per class.
model ExamClass {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  examId            String    @map("exam_id") @db.Uuid
  classLevelId      String    @map("class_level_id") @db.Uuid
  isPublished       Boolean   @default(false) @map("is_published")
  /// Bumped on every publish; result SMS and guardians see this version.
  publishedVersion  Int       @default(0) @map("published_version")
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(3)
  publishedById     String?   @map("published_by_id") @db.Uuid
  unpublishedReason String?   @map("unpublished_reason")
  /// The scheme, bands and GPA rules the published results used.
  gradingSnapshot   Json?     @map("grading_snapshot")
  /// Highest and average marks per subject at publish.
  subjectStats      Json?     @map("subject_stats")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  exam        Exam       @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  classLevel  ClassLevel @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  publishedBy User?      @relation("ExamClassPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  subjects   ExamSubject[]
  candidates ExamCandidate[]
  results    ExamResult[]

  @@unique([tenantId, id])
  @@unique([tenantId, examId, classLevelId])
  /// So exam subjects can be checked against their exam and class.
  @@unique([tenantId, id, examId, classLevelId])
  @@index([tenantId, classLevelId])
  @@map("exam_classes")
}

/// A subject sat in an exam class, with the setup copied from the subject (parts, pass rule).
model ExamSubject {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  examId       String    @map("exam_id") @db.Uuid
  examClassId  String    @map("exam_class_id") @db.Uuid
  classLevelId String    @map("class_level_id") @db.Uuid
  subjectId    String    @map("subject_id") @db.Uuid
  /// Copied from the subject: NULL is every group.
  studyGroupId String?   @map("study_group_id") @db.Uuid
  /// Copied from the subject: in the elective pool (taken only when chosen).
  isElective   Boolean   @map("is_elective")
  passRule     PassRule  @map("pass_rule")
  /// The routine (admit cards): the paper's date and start time ("10:00").
  examDate     DateTime? @map("exam_date") @db.Date
  startTime    String?   @map("start_time")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  examClass  ExamClass   @relation(fields: [tenantId, examClassId, examId, classLevelId], references: [tenantId, id, examId, classLevelId], onDelete: Cascade, onUpdate: Restrict)
  subject    Subject     @relation(fields: [tenantId, subjectId, classLevelId], references: [tenantId, id, classLevelId], onDelete: Restrict, onUpdate: Restrict)
  studyGroup StudyGroup? @relation(fields: [tenantId, studyGroupId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  components ExamSubjectComponent[]
  passGroups ExamSubjectPassGroup[]
  sheets     ExamMarkSheet[]
  marks      ExamMark[]

  @@unique([tenantId, id])
  @@unique([tenantId, examClassId, subjectId])
  /// So marks can be checked against their exam.
  @@unique([tenantId, id, examId])
  /// So mark sheets can be checked against their exam and class.
  @@unique([tenantId, id, examId, classLevelId])
  @@index([tenantId, examId])
  @@index([tenantId, subjectId])
  @@map("exam_subjects")
}

/// A part of an exam subject (copied from subject_components when the exam is set up).
model ExamSubjectComponent {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  examSubjectId String        @map("exam_subject_id") @db.Uuid
  key           String
  kind          ComponentKind
  nameBn        String        @map("name_bn")
  nameEn        String        @map("name_en")
  fullMarks     Int           @map("full_marks")
  passMarks     Int?          @map("pass_marks")
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  examSubject ExamSubject @relation(fields: [tenantId, examSubjectId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  marks ExamMark[]

  @@unique([tenantId, id])
  @@unique([tenantId, examSubjectId, key])
  /// So marks can be checked against their exam subject.
  @@unique([tenantId, id, examSubjectId])
  @@map("exam_subject_components")
}

/// Combined pass mark per kind of an exam subject (pass rule COMBINED).
model ExamSubjectPassGroup {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  examSubjectId String        @map("exam_subject_id") @db.Uuid
  kind          ComponentKind
  passMarks     Int           @map("pass_marks")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  examSubject ExamSubject @relation(fields: [tenantId, examSubjectId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, examSubjectId, kind])
  @@map("exam_subject_pass_groups")
}

/// A student sitting an exam: the roster taken when the exam opened (class, section, group and
/// roll as they were), the seat, and the class teacher's remarks for the report card.
model ExamCandidate {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  examId       String              @map("exam_id") @db.Uuid
  studentId    String              @map("student_id") @db.Uuid
  classLevelId String              @map("class_level_id") @db.Uuid
  sectionId    String              @map("section_id") @db.Uuid
  studyGroupId String?             @map("study_group_id") @db.Uuid
  roll         Int?
  status       ExamCandidateStatus @default(ENROLLED)
  roomId       String?             @map("room_id") @db.Uuid
  seatNo       Int?                @map("seat_no")
  remarks      String?
  remarksById  String?             @map("remarks_by_id") @db.Uuid
  remarksAt    DateTime?           @map("remarks_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  exam       Exam        @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  examClass  ExamClass   @relation(fields: [tenantId, examId, classLevelId], references: [tenantId, examId, classLevelId], onDelete: Restrict, onUpdate: Restrict)
  student    Student     @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  section    Section     @relation(fields: [tenantId, sectionId, classLevelId], references: [tenantId, id, classLevelId], onDelete: Restrict, onUpdate: Restrict)
  studyGroup StudyGroup? @relation(fields: [tenantId, studyGroupId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  room       ExamRoom?   @relation(fields: [tenantId, roomId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  remarksBy  User?       @relation("ExamCandidateRemarksBy", fields: [remarksById], references: [id], onDelete: SetNull)

  marks   ExamMark[]
  results ExamResult[]

  @@unique([tenantId, id])
  @@unique([tenantId, examId, studentId])
  /// One student per seat (rows without a seat have NULLs, which never clash).
  @@unique([tenantId, examId, roomId, seatNo])
  @@index([tenantId, examId, sectionId])
  @@index([tenantId, examId, classLevelId])
  @@index([tenantId, sectionId])
  @@index([tenantId, roomId])
  @@index([tenantId, studentId])
  @@map("exam_candidates")
}

// ───────────────────────────── Exams: marks (step 10) ─────────────────────────────

/// One subject's marks for one section: its state, and the version used for safe saving (like an
/// attendance register). Marks themselves belong to the student (exam_marks), so they follow a
/// transfer; the sheet of the student's current section governs them.
model ExamMarkSheet {
  id               String          @id @default(uuid(7)) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  examId           String          @map("exam_id") @db.Uuid
  examSubjectId    String          @map("exam_subject_id") @db.Uuid
  classLevelId     String          @map("class_level_id") @db.Uuid
  sectionId        String          @map("section_id") @db.Uuid
  status           MarkSheetStatus @default(DRAFT)
  /// Bumped on every change; a save from an older version gets 409 VERSION_CONFLICT.
  version          Int             @default(0)
  /// The client's id for its last save (a retry of it is answered with the saved state).
  lastSubmissionId String?         @map("last_submission_id") @db.Uuid
  /// Why an admin returned the sheet to its teacher (shown to them).
  returnNote       String?         @map("return_note")
  updatedById      String?         @map("updated_by_id") @db.Uuid
  submittedById    String?         @map("submitted_by_id") @db.Uuid
  submittedAt      DateTime?       @map("submitted_at") @db.Timestamptz(3)
  lockedById       String?         @map("locked_by_id") @db.Uuid
  lockedAt         DateTime?       @map("locked_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  examSubject ExamSubject @relation(fields: [tenantId, examSubjectId, examId, classLevelId], references: [tenantId, id, examId, classLevelId], onDelete: Restrict, onUpdate: Restrict)
  section     Section     @relation(fields: [tenantId, sectionId, classLevelId], references: [tenantId, id, classLevelId], onDelete: Restrict, onUpdate: Restrict)
  updatedBy   User?       @relation("ExamSheetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  submittedBy User?       @relation("ExamSheetSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  lockedBy    User?       @relation("ExamSheetLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([tenantId, examSubjectId, sectionId])
  @@index([tenantId, examId])
  @@index([tenantId, sectionId])
  @@map("exam_mark_sheets")
}

/// A student's marks in one part (integer hundredths: 56.5 → 5650), or absent. No row, or neither
/// marks nor absent, means not entered. History: never deleted; only the score changes.
model ExamMark {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  examId        String   @map("exam_id") @db.Uuid
  examSubjectId String   @map("exam_subject_id") @db.Uuid
  componentId   String   @map("component_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  scoreH        Int?     @map("score_h")
  absent        Boolean  @default(false)
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  examSubject ExamSubject          @relation(fields: [tenantId, examSubjectId, examId], references: [tenantId, id, examId], onDelete: Restrict, onUpdate: Restrict)
  component   ExamSubjectComponent @relation(fields: [tenantId, componentId, examSubjectId], references: [tenantId, id, examSubjectId], onDelete: Restrict, onUpdate: Restrict)
  candidate   ExamCandidate        @relation(fields: [tenantId, examId, studentId], references: [tenantId, examId, studentId], onDelete: Restrict, onUpdate: Restrict)
  updatedBy   User?                @relation("ExamMarkUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([tenantId, componentId, studentId])
  @@index([tenantId, examSubjectId, studentId])
  @@index([tenantId, examId, studentId])
  @@map("exam_marks")
}

/// One register: a section on a date, for the whole day (period_no 0) or one period.
model AttendanceSession {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  sectionId        String           @map("section_id") @db.Uuid
  date             DateTime         @db.Date
  /// 0 = the whole day (DAILY mode); 1.. = a period (PER_SESSION mode).
  periodNo         Int              @default(0) @map("period_no") @db.SmallInt
  subjectId        String?          @map("subject_id") @db.Uuid
  /// DEVICE: written by the device job at the cutoff, with no taker.
  source           AttendanceSource @default(MANUAL)
  /// NULL only on a DEVICE register (CHECKs).
  takenById        String?          @map("taken_by_id") @db.Uuid
  updatedById      String?          @map("updated_by_id") @db.Uuid
  submittedAt      DateTime         @map("submitted_at") @db.Timestamptz(3)
  /// Optimistic concurrency: a submit must name the version it was based on.
  version          Int              @default(1)
  /// The client's id for the last accepted submit, so a retried request is answered, not re-applied.
  lastSubmissionId String           @map("last_submission_id") @db.Uuid
  /// Taken on a weekly off day or holiday (admin override).
  onNonWorkingDay  Boolean          @default(false) @map("on_non_working_day")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  section   Section            @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict)
  subject   Subject?           @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  takenBy   User?              @relation("AttendanceTakenBy", fields: [takenById], references: [id], onDelete: Restrict)
  updatedBy User?              @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  records   AttendanceRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, sectionId, date, periodNo])
  @@index([tenantId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    AttendanceStatus
  note      String?
  source    AttendanceSource @default(MANUAL)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session AttendanceSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)
  student Student           @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, studentId])
  @@index([tenantId, studentId])
  @@map("attendance_records")
}

// ───────────────────────────── SMS logs ─────────────────────────────

/// Every SMS sent for a tenant (we bill from this). Bodies of tenant SMS never contain secrets.
model SmsLog {
  id                String     @id @default(uuid(7)) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  phone             String
  purpose           SmsPurpose
  status            SmsStatus  @default(QUEUED)
  segments          Int        @db.SmallInt
  body              String
  /// The tenant-local day it belongs to (daily cap, billing).
  localDate         DateTime   @map("local_date") @db.Date
  /// At most one SMS per key per tenant, e.g. "absent:<student_id>:<date>".
  dedupeKey         String?    @map("dedupe_key")
  relatedEntity     String?    @map("related_entity")
  relatedId         String?    @map("related_id") @db.Uuid
  sendAfter         DateTime?  @map("send_after") @db.Timestamptz(3)
  sentAt            DateTime?  @map("sent_at") @db.Timestamptz(3)
  /// Set when sent: segments × the platform's rate then (a later rate change keeps past costs).
  costPaisa         Int?       @map("cost_paisa")
  providerMessageId String?    @map("provider_message_id")
  error             String?
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, dedupeKey], map: "sms_logs_dedupe", where: raw("dedupe_key IS NOT NULL"))
  @@index([tenantId, localDate])
  @@index([tenantId, createdAt(sort: Desc)])
  /// Platform usage: a month's sent SMS across institutes.
  @@index([localDate], map: "sms_logs_sent_local_date", where: raw("status = 'SENT'"))
  /// A broadcast's SMS by state (the broadcasts list, sprint 1 P6b).
  @@index([tenantId, relatedId])
  @@map("sms_logs")
}

/// Global: SMS sent before any tenant is known (login OTP). The app role may only INSERT, never
/// read: it holds phone numbers of every user. The body (it contains the OTP) is never stored.
model PlatformSmsLog {
  id                String             @id @default(uuid(7)) @db.Uuid
  phone             String
  purpose           PlatformSmsPurpose
  status            PlatformSmsStatus
  segments          Int                @db.SmallInt
  /// SENT rows: segments × the platform's rate when sent.
  costPaisa         Int?               @map("cost_paisa")
  providerMessageId String?            @map("provider_message_id")
  error             String?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("platform_sms_logs")
}

// ───────────────────────────── The request context key (P1-J8) ─────────────────────────────

/// The key the API signs every transaction's context with (docs/database.md → The request
/// context). One row, generated by its migration; no runtime login may read it except through
/// auth_context_key(), which only jantrik_login_app (and the owner) may run.
model AppContextKey {
  id        Int      @id @db.SmallInt
  /// 48 random bytes.
  key       Bytes
  /// The key XOR the HMAC inner and outer pads (64 bytes each).
  innerPad  Bytes    @map("inner_pad")
  outerPad  Bytes    @map("outer_pad")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("app_context_key")
}

// ───────────────────────────── Auth sessions ─────────────────────────────
// User-owned (not tenant-owned): RLS on user_id = app_current_user_id(). See docs/auth.md.

/// One login on one device ("logged-in devices"). Refresh tokens rotate inside it.
model Session {
  id             String               @id @default(uuid(7)) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  /// Tenant selected via switch-tenant; refresh re-issues access tokens for it.
  activeTenantId String?              @map("active_tenant_id") @db.Uuid
  client         SessionClient
  userAgent      String?              @map("user_agent")
  ip             String?
  lastUsedAt     DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Sliding: renewed on every refresh.
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokeReason   SessionRevokeReason? @map("revoke_reason")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant  Tenant?        @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@unique([userId, id])
  @@index([userId])
  @@map("sessions")
}

/// Rotation chain of a session. Only the SHA-256 of each token is stored.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when this token was exchanged for a new one. Presenting it again is reuse
  /// (except the 30 s idempotent-retry window, see docs/auth.md).
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session Session @relation(fields: [userId, sessionId], references: [userId, id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────── Platform (Jantrik's own staff) ───────────────────────────
// Global tables, not tenant data. jantrik_app has no grants on them: the API reaches them only
// through SECURITY DEFINER functions owned by jantrik_platform (see docs/platform.md).

enum PlatformSessionRevokeReason {
  LOGOUT
  DISABLED
  RESET_2FA

  @@map("platform_session_revoke_reason")
}

enum PlatformActor {
  ADMIN
  CLI

  @@map("platform_actor")
}

/// A Jantrik staff member who runs the platform. Never a `users` row.
model PlatformAdmin {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  /// E.164 (+8801…).
  phone         String    @unique
  email         String?   @unique
  passwordHash  String    @map("password_hash")
  /// TOTP secret, AES-256-GCM encrypted with PLATFORM_TOTP_KEY; NULL until enrolled.
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Until when the authenticator may be set up (first login, or after reset-2fa); NULL: closed.
  totpEnrolBy   DateTime? @map("totp_enrol_by") @db.Timestamptz(3)
  /// Last accepted 30 s time step (a code is never accepted twice).
  totpLastStep  BigInt?   @map("totp_last_step")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  backupCodes   PlatformAdminBackupCode[]
  sessions      PlatformSession[]
  auditLogs     PlatformAuditLog[]
  payments      PlatformPayment[]
  settingsEdits PlatformSettings[]

  @@map("platform_admins")
}

/// One-time 2FA backup codes (HMAC hashes, never the codes).
model PlatformAdminBackupCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, codeHash])
  @@map("platform_admin_backup_codes")
}

/// A signed-in platform admin: an opaque cookie token (only its hash here). Short: idle and
/// absolute expiry, checked on every request.
model PlatformSession {
  id            String                       @id @default(uuid(7)) @db.Uuid
  adminId       String                       @map("admin_id") @db.Uuid
  tokenHash     String                       @unique @map("token_hash") @db.Char(64)
  ip            String?
  userAgent     String?                      @map("user_agent")
  lastUsedAt    DateTime                     @default(now()) @map("last_used_at") @db.Timestamptz(3)
  idleExpiresAt DateTime                     @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt     DateTime                     @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  revokeReason  PlatformSessionRevokeReason? @map("revoke_reason")
  createdAt     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_sessions")
}

/// Everything platform admins (and the CLI) do. Append-only.
model PlatformAuditLog {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// NULL for CLI actions.
  adminId        String?       @map("admin_id") @db.Uuid
  actor          PlatformActor
  action         String
  /// The institute acted on, if any (not `tenant_id`: this is not a tenant table).
  targetTenantId String?       @map("target_tenant_id") @db.Uuid
  entity         String?
  entityId       String?       @map("entity_id")
  details        Json?         @db.JsonB
  ip             String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([targetTenantId, createdAt(sort: Desc)])
  @@map("platform_audit_logs")
}

/// How a plan charges: per active student per month for each enabled module, or a flat price.
enum PlanPricing {
  PER_STUDENT
  FLAT

  @@map("plan_pricing")
}

enum BillingCycle {
  MONTHLY
  YEARLY

  @@map("billing_cycle")
}

/// Jantrik's plan and limits for one institute. The institute may read its own row (the limits are
/// enforced in its requests); only the platform functions (jantrik_platform) write it. Institutes
/// created before step 8 have none: no plan, no limits. Amounts in paisa.
model TenantSubscription {
  id                    String       @id @default(uuid(7)) @db.Uuid
  tenantId              String       @unique @map("tenant_id") @db.Uuid
  /// NULL: no plan yet (nothing is invoiced).
  planName              String?      @map("plan_name")
  pricing               PlanPricing  @default(PER_STUDENT)
  /// PER_STUDENT: paisa per active student per month, per enabled module (CORE is always on).
  corePaisa             Int          @default(0) @map("core_paisa")
  attendancePaisa       Int          @default(0) @map("attendance_paisa")
  feesPaisa             Int          @default(0) @map("fees_paisa")
  examsPaisa            Int          @default(0) @map("exams_paisa")
  /// FLAT: paisa per month.
  flatPaisa             Int          @default(0) @map("flat_paisa")
  cycle                 BillingCycle @default(MONTHLY)
  /// YEARLY: 12 × monthly minus this percentage.
  yearlyDiscountPercent Int          @default(0) @map("yearly_discount_percent") @db.SmallInt
  /// Invoices are due this many days after they are issued.
  dueDays               Int          @default(10) @map("due_days") @db.SmallInt
  trialEndsOn           DateTime?    @map("trial_ends_on") @db.Date
  /// Admissions and imports stop once active students reach it. NULL: no limit.
  studentLimit          Int?         @map("student_limit")
  /// A ceiling on the institute's daily SMS cap (the lower of the two applies). NULL: none.
  smsDailyCap           Int?         @map("sms_daily_cap")
  /// The first month invoiced (its first day). Set on activation (the next month); NULL: not yet.
  billingStartsOn       DateTime?    @map("billing_starts_on") @db.Date
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("tenant_subscriptions")
}

/// The new owner's setup wizard (step 8, part 5): one row per institute the platform creates.
/// Institutes without one (made before the wizard, the demo ones) never see the wizard.
model OnboardingProgress {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @unique @map("tenant_id") @db.Uuid
  /// Step key (year, classes, shifts, teachers, students, attendance) to 'done' or 'skipped'.
  /// A missing key: not answered yet.
  steps       Json      @default("{}") @db.JsonB
  /// Set when the wizard is finished; the dashboard then stops offering it.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("onboarding_progress")
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID

  @@map("invoice_status")
}

/// A line of a platform invoice: a module (per active student), the flat price, or the yearly
/// discount (a negative amount).
enum InvoiceLineKind {
  CORE
  ATTENDANCE
  FEES
  EXAMS
  FLAT
  DISCOUNT

  @@map("invoice_line_kind")
}

enum PaymentMethod {
  CASH
  BKASH
  BANK

  @@map("payment_method")
}

/// Jantrik's invoice to an institute for one period (a month, or 12 months on a yearly plan).
/// The institute may read its own; only the platform functions write. Overdue = ISSUED and past
/// due_on (computed, not stored). History: no DELETE for anyone.
model PlatformInvoice {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  cycle       BillingCycle
  issuedOn    DateTime      @map("issued_on") @db.Date
  dueOn       DateTime      @map("due_on") @db.Date
  status      InvoiceStatus @default(ISSUED)
  totalPaisa  Int           @map("total_paisa")
  paidPaisa   Int           @default(0) @map("paid_paisa")
  voidReason  String?       @map("void_reason")
  voidedAt    DateTime?     @map("voided_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lines    PlatformInvoiceLine[]
  payments PlatformPayment[]

  @@unique([tenantId, id])
  /// One live invoice per institute and period (a voided one can be issued again).
  @@unique([tenantId, periodStart], map: "platform_invoices_tenant_period", where: raw("status <> 'VOID'"))
  @@index([tenantId, dueOn])
  @@map("platform_invoices")
}

model PlatformInvoiceLine {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  invoiceId      String          @map("invoice_id") @db.Uuid
  kind           InvoiceLineKind
  /// Per-student lines: the active students counted when the invoice was made.
  activeStudents Int?            @map("active_students")
  unitPaisa      Int             @map("unit_paisa")
  months         Int             @db.SmallInt
  amountPaisa    Int             @map("amount_paisa")
  sortOrder      Int             @default(0) @map("sort_order") @db.SmallInt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice PlatformInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@map("platform_invoice_lines")
}

/// A payment recorded by a platform admin (cash, bKash or bank). Append-only.
model PlatformPayment {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  amountPaisa  Int           @map("amount_paisa")
  method       PaymentMethod
  reference    String?
  paidOn       DateTime      @map("paid_on") @db.Date
  recordedById String        @map("recorded_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice    PlatformInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  recordedBy PlatformAdmin   @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@map("platform_payments")
}

/// Platform-wide settings: one row (id 1). Global on purpose (Jantrik's own costs, not an
/// institute's): no tenant_id, no RLS. The app reads only the SMS rate; only the platform
/// functions change it (audited).
model PlatformSettings {
  id                     Int      @id @default(1) @db.SmallInt
  /// What one SMS segment costs Jantrik, copied onto every SMS when it is sent.
  smsCostPerSegmentPaisa Int      @default(30) @map("sms_cost_per_segment_paisa")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById            String?  @map("updated_by_id") @db.Uuid

  updatedBy PlatformAdmin? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

// ───────────────────────────── Fees (module FEES, step 9) ─────────────────────────────
// Rules: docs/fees.md. Money is integer paisa; dates are calendar dates in the tenant's timezone.

enum FeeHeadKind {
  ADMISSION
  TUITION
  EXAM
  SESSION
  OTHER

  @@map("fee_head_kind")
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  PER_TERM
  YEARLY

  @@map("fee_frequency")
}

enum FeeFineType {
  NONE
  /// A fixed amount once the due date has passed.
  FLAT
  /// An amount per day after the due date, up to a cap.
  PER_DAY

  @@map("fee_fine_type")
}

/// FIXED: paisa. PERCENT: whole percent 1–100.
enum FeeAmountType {
  FIXED
  PERCENT

  @@map("fee_amount_type")
}

enum FeeConcessionCategory {
  GENERAL
  /// Full free studentship (100 %).
  FREE_FULL
  /// Half free studentship (50 %).
  FREE_HALF
  /// Needs a reason.
  SCHOLARSHIP

  @@map("fee_concession_category")
}

/// One row per tenant once an admin saves it; defaults live in code until then (no backfill).
model FeeSettings {
  id                   String         @id @default(uuid(7)) @db.Uuid
  tenantId             String         @unique @map("tenant_id") @db.Uuid
  /// First day of the first month that gets dues. Null: no dues are generated yet, so switching
  /// fees on mid-year never charges earlier months.
  duesFrom             DateTime?      @map("dues_from") @db.Date
  receiptSmsEnabled    Boolean        @default(true) @map("receipt_sms_enabled")
  /// Discount for the from_child-th and later child of a confirmed family; null = none.
  siblingDiscountType  FeeAmountType? @map("sibling_discount_type")
  siblingDiscountValue Int?           @map("sibling_discount_value")
  siblingFromChild     Int            @default(2) @map("sibling_from_child") @db.SmallInt
  /// A line printed at the foot of every receipt (address, phone, thanks).
  receiptNote          String?        @map("receipt_note")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("fee_settings")
}

/// What is charged (tuition, admission, exam…) and how often. Deactivated, never deleted.
model FeeHead {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  nameBn          String       @map("name_bn")
  nameEn          String       @map("name_en")
  kind            FeeHeadKind
  frequency       FeeFrequency
  /// MONTHLY only: day of the month the fee is due (1–28).
  dueDay          Int?         @map("due_day") @db.SmallInt
  /// YEARLY: days after the year starts; ONE_TIME: days after admission.
  dueOffsetDays   Int          @default(0) @map("due_offset_days") @db.SmallInt
  /// ONE_TIME only: charged to students admitted on or after this date; null = never automatic.
  oneTimeFrom     DateTime?    @map("one_time_from") @db.Date
  fineType        FeeFineType  @default(NONE) @map("fine_type")
  fineAmountPaisa Int          @default(0) @map("fine_amount_paisa")
  /// PER_DAY only: the most a due's fine can reach.
  fineCapPaisa    Int?         @map("fine_cap_paisa")
  /// The sibling discount applies to this head.
  siblingEligible Boolean      @default(false) @map("sibling_eligible")
  isActive        Boolean      @default(true) @map("is_active")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  amounts     FeeAmount[]
  concessions FeeConcession[]
  dues        FeeDue[]

  @@unique([tenantId, id])
  // Unique among active heads only: a deactivated head frees its name.
  @@unique([tenantId, nameBn], map: "fee_heads_active_name", where: raw("is_active"))
  @@index([tenantId, sortOrder])
  @@map("fee_heads")
}

/// A term of an academic year, for PER_TERM heads (opens, then falls due).
model FeeTerm {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  nameBn         String   @map("name_bn")
  nameEn         String   @map("name_en")
  opensOn        DateTime @map("opens_on") @db.Date
  dueDate        DateTime @map("due_date") @db.Date
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  dues         FeeDue[]

  @@unique([tenantId, id])
  /// Composite target for dues: a term due names a term of its own year.
  @@unique([tenantId, id, academicYearId])
  @@unique([tenantId, academicYearId, nameBn])
  @@index([tenantId, academicYearId])
  @@map("fee_terms")
}

/// How much a head costs for a class level in a year; a study-group row overrides the class row.
model FeeAmount {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  feeHeadId      String   @map("fee_head_id") @db.Uuid
  classLevelId   String   @map("class_level_id") @db.Uuid
  studyGroupId   String?  @map("study_group_id") @db.Uuid
  amountPaisa    Int      @map("amount_paisa")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  feeHead      FeeHead      @relation(fields: [tenantId, feeHeadId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  classLevel   ClassLevel   @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  studyGroup   StudyGroup?  @relation(fields: [tenantId, studyGroupId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, feeHeadId, classLevelId], map: "fee_amounts_class_default", where: raw("study_group_id IS NULL"))
  @@unique([tenantId, academicYearId, feeHeadId, classLevelId, studyGroupId], map: "fee_amounts_group_override", where: raw("study_group_id IS NOT NULL"))
  @@index([tenantId, academicYearId, classLevelId])
  @@map("fee_amounts")
}

/// A student's concession on one head for one year. Ended (ended_on), never deleted.
model FeeConcession {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  studentId      String                @map("student_id") @db.Uuid
  feeHeadId      String                @map("fee_head_id") @db.Uuid
  academicYearId String                @map("academic_year_id") @db.Uuid
  category       FeeConcessionCategory
  type           FeeAmountType
  value          Int
  reason         String?
  /// Applies to dues falling due on or after this date.
  validFrom      DateTime              @map("valid_from") @db.Date
  /// Applies to dues falling due before this date; null = still active.
  endedOn        DateTime?             @map("ended_on") @db.Date
  endedReason    String?               @map("ended_reason")
  createdById    String                @map("created_by_id") @db.Uuid
  endedById      String?               @map("ended_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student      Student      @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  feeHead      FeeHead      @relation(fields: [tenantId, feeHeadId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User         @relation("FeeConcessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  endedBy      User?        @relation("FeeConcessionEndedBy", fields: [endedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dues         FeeDue[]

  @@unique([tenantId, id])
  /// Composite target for dues: a due may only name its own student's concession on its head and year.
  @@unique([tenantId, id, studentId, feeHeadId, academicYearId])
  @@unique([tenantId, studentId, feeHeadId, academicYearId], map: "fee_concessions_one_active", where: raw("ended_on IS NULL"))
  @@index([tenantId, studentId])
  @@map("fee_concessions")
}

/// A family confirmed by an admin (siblings get the sibling discount only once confirmed).
model FeeSiblingGroup {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User               @relation("FeeSiblingGroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members   FeeSiblingMember[]

  @@unique([tenantId, id])
  @@map("fee_sibling_groups")
}

/// A student in a confirmed family. Removed (removed_at), never deleted.
model FeeSiblingMember {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  groupId       String    @map("group_id") @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  addedById     String    @map("added_by_id") @db.Uuid
  removedAt     DateTime? @map("removed_at") @db.Timestamptz(3)
  removedById   String?   @map("removed_by_id") @db.Uuid
  removedReason String?   @map("removed_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  group     FeeSiblingGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  student   Student         @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  addedBy   User            @relation("FeeSiblingMemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removedBy User?           @relation("FeeSiblingMemberRemovedBy", fields: [removedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, studentId], map: "fee_sibling_members_one_family", where: raw("removed_at IS NULL"))
  @@index([tenantId, groupId])
  @@map("fee_sibling_members")
}

enum FeeDueStatus {
  OPEN
  /// Cancelled by an admin (with a reason) before anything was paid; never regenerated.
  CANCELLED

  @@map("fee_due_status")
}

enum FeeConcessionSource {
  NONE
  MANUAL
  SIBLING

  @@map("fee_concession_source")
}

/// What one student owes for one head and period. Generated (idempotently) from the setup, with
/// a snapshot of the amount, concession and fine rule; paid and waived totals are cached and
/// written only by the fee services (recomputed from allocations and waivers). Never deleted.
model FeeDue {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  studentId          String              @map("student_id") @db.Uuid
  feeHeadId          String              @map("fee_head_id") @db.Uuid
  academicYearId     String              @map("academic_year_id") @db.Uuid
  /// 'YYYY-MM' (monthly), 'T:<term id>' (per term), 'Y' (yearly), 'ONCE' (one-time).
  periodKey          String              @map("period_key")
  feeTermId          String?             @map("fee_term_id") @db.Uuid
  periodStart        DateTime            @map("period_start") @db.Date
  dueDate            DateTime            @map("due_date") @db.Date
  amountPaisa        Int                 @map("amount_paisa")
  concessionPaisa    Int                 @default(0) @map("concession_paisa")
  concessionSource   FeeConcessionSource @default(NONE) @map("concession_source")
  concessionId       String?             @map("concession_id") @db.Uuid
  fineType           FeeFineType         @map("fine_type")
  fineAmountPaisa    Int                 @map("fine_amount_paisa")
  fineCapPaisa       Int?                @map("fine_cap_paisa")
  paidPrincipalPaisa Int                 @default(0) @map("paid_principal_paisa")
  paidFinePaisa      Int                 @default(0) @map("paid_fine_paisa")
  /// The day the principal was fully paid: the fine stops growing then.
  principalClearedOn DateTime?           @map("principal_cleared_on") @db.Date
  fineWaivedPaisa    Int                 @default(0) @map("fine_waived_paisa")
  fineWaivedAll      Boolean             @default(false) @map("fine_waived_all")
  status             FeeDueStatus        @default(OPEN)
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?             @map("cancelled_by_id") @db.Uuid
  cancelReason       String?             @map("cancel_reason")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student      Student                  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  feeHead      FeeHead                  @relation(fields: [tenantId, feeHeadId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  academicYear AcademicYear             @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  feeTerm      FeeTerm?                 @relation(fields: [tenantId, feeTermId, academicYearId], references: [tenantId, id, academicYearId], onDelete: Restrict, onUpdate: Restrict)
  concession   FeeConcession?           @relation(fields: [tenantId, concessionId, studentId, feeHeadId, academicYearId], references: [tenantId, id, studentId, feeHeadId, academicYearId], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy  User?                    @relation("FeeDueCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fineWaivers  FeeFineWaiver[]
  allocations  FeePaymentAllocation[]
  submissions  FeeMobileSubmissionDue[]
  intentDues   PaymentIntentDue[]

  @@unique([tenantId, id])
  /// Composite target for rows that must name the due's own student (allocations, waivers).
  @@unique([tenantId, id, studentId])
  @@unique([tenantId, studentId, feeHeadId, academicYearId, periodKey])
  @@unique([tenantId, studentId, feeHeadId], map: "fee_dues_one_time_once", where: raw("period_key = 'ONCE'"))
  @@index([tenantId, academicYearId, status, dueDate])
  @@map("fee_dues")
}

/// An admin waived (part of) a due's late fine, with a reason. Append-only.
model FeeFineWaiver {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  dueId       String   @map("due_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  /// Null: the whole fine, now and later.
  amountPaisa Int?     @map("amount_paisa")
  reason      String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  due       FeeDue  @relation(fields: [tenantId, dueId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  student   Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User    @relation("FeeFineWaiverCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, dueId])
  @@map("fee_fine_waivers")
}

enum FeePaymentMethod {
  CASH
  BKASH
  NAGAD
  /// Online only (SSLCommerz, S21): Rocket, a card, any other instrument the gateway reports.
  ROCKET
  CARD
  OTHER_ONLINE

  @@map("fee_payment_method")
}

enum FeePaymentChannel {
  /// Cash at the fee counter.
  COUNTER
  /// A bKash/Nagad transfer to the institute's own number, verified by staff.
  MOBILE_MANUAL
  /// Paid online through the institute's gateway account (SSLCommerz), confirmed by its API.
  GATEWAY

  @@map("fee_payment_channel")
}

enum FeePaymentStatus {
  ACTIVE
  VOID

  @@map("fee_payment_status")
}

/// Next receipt number per tenant and calendar year (atomic upsert inside the payment's
/// transaction, so a rolled-back payment gives its number back: no gaps).
model FeeReceiptCounter {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  year      Int
  nextValue Int      @map("next_value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, year])
  @@map("fee_receipt_counters")
}

/// Money received from (for) one student, with its receipt number. Never edited or deleted:
/// only voided, once, with a reason (column grants + a trigger). Allocations say which dues it paid.
model FeePayment {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  studentId       String            @map("student_id") @db.Uuid
  /// Calendar year (tenant timezone) of recorded_on; numbers restart every year.
  receiptYear     Int               @map("receipt_year")
  receiptNo       Int               @map("receipt_no")
  method          FeePaymentMethod
  channel         FeePaymentChannel
  amountPaisa     Int               @map("amount_paisa")
  /// When the payer paid (fines are computed to this day).
  paidOn          DateTime          @map("paid_on") @db.Date
  /// When it was recorded (receipt year, daily closing).
  recordedOn      DateTime          @map("recorded_on") @db.Date
  trxId           String?           @map("trx_id")
  senderPhone     String?           @map("sender_phone")
  /// Who took the cash or verified the transfer.
  collectedById   String            @map("collected_by_id") @db.Uuid
  /// The client's id for this attempt: a retried request returns the same receipt.
  clientRequestId String            @map("client_request_id") @db.Uuid
  status          FeePaymentStatus  @default(ACTIVE)
  /// GATEWAY only: the online payment it records (exactly one live payment per intent).
  paymentIntentId String?           @map("payment_intent_id") @db.Uuid
  voidedAt        DateTime?         @map("voided_at") @db.Timestamptz(3)
  voidedById      String?           @map("voided_by_id") @db.Uuid
  voidReason      String?           @map("void_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student        Student                @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  collectedBy    User                   @relation("FeePaymentCollectedBy", fields: [collectedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  voidedBy       User?                  @relation("FeePaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  allocations    FeePaymentAllocation[]
  submissions    FeeMobileSubmission[]
  /// Same student: an online payment only ever pays its own child's dues.
  paymentIntent  PaymentIntent?         @relation("FeePaymentIntent", fields: [tenantId, paymentIntentId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  intentsHolding PaymentIntent[]        @relation("PaymentIntentFeePayment")

  @@unique([tenantId, id])
  @@unique([tenantId, id, studentId])
  @@unique([tenantId, receiptYear, receiptNo])
  @@unique([tenantId, clientRequestId])
  /// A bKash/Nagad transaction ID pays once per method (again only after that payment is void).
  @@unique([tenantId, method, trxId], map: "fee_payments_live_trx", where: raw("status = 'ACTIVE' AND trx_id IS NOT NULL"))
  /// One live payment per online payment intent (a voided one may be applied again, P7a-G).
  @@unique([tenantId, paymentIntentId], map: "fee_payments_live_intent", where: raw("status = 'ACTIVE' AND payment_intent_id IS NOT NULL"))
  @@index([tenantId, studentId])
  @@index([tenantId, recordedOn])
  @@map("fee_payments")
}

/// The part of a payment that went to one due (principal and fine). Append-only.
model FeePaymentAllocation {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  dueId          String   @map("due_id") @db.Uuid
  principalPaisa Int      @map("principal_paisa")
  finePaisa      Int      @map("fine_paisa")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Payment and due share the student: a payment can never pay another student's due.
  payment FeePayment @relation(fields: [tenantId, paymentId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  due     FeeDue     @relation(fields: [tenantId, dueId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  student Student    @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, paymentId, dueId])
  @@index([tenantId, dueId])
  @@map("fee_payment_allocations")
}

enum FeeMobileAccountKind {
  PERSONAL
  MERCHANT
  AGENT

  @@map("fee_mobile_account_kind")
}

enum FeeSubmissionStatus {
  PENDING
  /// Checked by staff in the institute's bKash/Nagad app: a payment and receipt were made.
  VERIFIED
  /// Not found or wrong (reason given); the TrxID may be submitted again.
  REJECTED
  /// Verified, then its payment was voided; the TrxID is free again.
  VOIDED

  @@map("fee_submission_status")
}

enum FeeSubmitter {
  GUARDIAN
  STAFF

  @@map("fee_submitter")
}

/// The institute's own bKash/Nagad number that guardians send money to (OWNER sets them).
model FeeMobileAccount {
  id        String               @id @default(uuid(7)) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  method    FeePaymentMethod
  phone     String
  kind      FeeMobileAccountKind
  label     String?
  isActive  Boolean              @default(true) @map("is_active")
  sortOrder Int                  @default(0) @map("sort_order")
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  submissions FeeMobileSubmission[]

  @@unique([tenantId, id])
  /// Composite target: a submission's method matches its account's.
  @@unique([tenantId, id, method])
  @@unique([tenantId, method, phone])
  @@index([tenantId, isActive])
  @@map("fee_mobile_accounts")
}

/// "I paid by bKash/Nagad": amount, TrxID and sender number for chosen dues, from a guardian or
/// staff. Staff verify it against the institute's own app (→ a payment and receipt) or reject it.
model FeeMobileSubmission {
  id              String              @id @default(uuid(7)) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  studentId       String              @map("student_id") @db.Uuid
  method          FeePaymentMethod
  accountId       String              @map("account_id") @db.Uuid
  amountPaisa     Int                 @map("amount_paisa")
  trxId           String              @map("trx_id")
  senderPhone     String              @map("sender_phone")
  /// The day it was submitted (the payment's paid_on: fines stop there).
  sentOn          DateTime            @map("sent_on") @db.Date
  submittedById   String              @map("submitted_by_id") @db.Uuid
  submitter       FeeSubmitter
  status          FeeSubmissionStatus @default(PENDING)
  reviewedById    String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  rejectReason    String?             @map("reject_reason")
  paymentId       String?             @map("payment_id") @db.Uuid
  clientRequestId String              @map("client_request_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student     Student                  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  account     FeeMobileAccount         @relation(fields: [tenantId, accountId, method], references: [tenantId, id, method], onDelete: Restrict, onUpdate: Restrict)
  payment     FeePayment?              @relation(fields: [tenantId, paymentId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  submittedBy User                     @relation("FeeSubmissionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy  User?                    @relation("FeeSubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dues        FeeMobileSubmissionDue[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, studentId])
  @@unique([tenantId, clientRequestId])
  /// A TrxID is open (pending or verified) once per method.
  @@unique([tenantId, method, trxId], map: "fee_mobile_submissions_open_trx", where: raw("status = ANY (ARRAY['PENDING'::fee_submission_status, 'VERIFIED'::fee_submission_status])"))
  @@index([tenantId, status, createdAt])
  @@index([tenantId, studentId])
  @@map("fee_mobile_submissions")
}

/// The dues a submission is for (the student's own, by composite keys).
model FeeMobileSubmissionDue {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  dueId        String   @map("due_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  submission FeeMobileSubmission @relation(fields: [tenantId, submissionId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  due        FeeDue              @relation(fields: [tenantId, dueId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  student    Student             @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, submissionId, dueId])
  @@index([tenantId, dueId])
  @@map("fee_mobile_submission_dues")
}

/// A student's published result in one exam class: a snapshot taken at publish (and rebuilt on a
/// republish), so guardians, report cards and SMS read exactly what was published.
model ExamResult {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  examId              String   @map("exam_id") @db.Uuid
  examClassId         String   @map("exam_class_id") @db.Uuid
  classLevelId        String   @map("class_level_id") @db.Uuid
  studentId           String   @map("student_id") @db.Uuid
  sectionId           String   @map("section_id") @db.Uuid
  roll                Int?
  /// Marks as hundredths; percent as hundredths of a percent.
  totalH              Int      @map("total_h")
  fullMarks           Int      @map("full_marks")
  percentH            Int      @map("percent_h")
  /// GPA as hundredths (GPA mode only).
  gpaH                Int?     @map("gpa_h")
  gpaWithoutOptionalH Int?     @map("gpa_wo_optional_h")
  letter              String?
  passed              Boolean
  failedSubjects      Int      @map("failed_subjects")
  /// NULL: unranked (a failed student when the exam leaves them out of the merit list).
  classPosition       Int?     @map("class_position")
  sectionPosition     Int?     @map("section_position")
  attendancePresent   Int?     @map("attendance_present")
  attendanceTotal     Int?     @map("attendance_total")
  attendancePercentH  Int?     @map("attendance_percent_h")
  remarks             String?
  /// Per subject: parts, marks, grade, pass (the report card's table).
  subjects            Json
  publishedVersion    Int      @map("published_version")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  examClass ExamClass     @relation(fields: [tenantId, examClassId, examId, classLevelId], references: [tenantId, id, examId, classLevelId], onDelete: Restrict, onUpdate: Restrict)
  candidate ExamCandidate @relation(fields: [tenantId, examId, studentId], references: [tenantId, examId, studentId], onDelete: Restrict, onUpdate: Restrict)
  section   Section       @relation(fields: [tenantId, sectionId, classLevelId], references: [tenantId, id, classLevelId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, examClassId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, examId])
  @@index([tenantId, sectionId])
  @@map("exam_results")
}

// ───────────────────────────── Attendance devices ─────────────────────────────
// Module ATTENDANCE (step 11): ZKTeco push devices. The receiver reaches these tables only
// through the ingest_* functions (owned by jantrik_ingest, with its own `TO jantrik_ingest`
// policies); see docs/database.md → Devices.

enum DeviceBrand {
  ZKTECO

  @@map("device_brand")
}

/// An IN or OUT device decides a punch's direction; on a BOTH device the state it sends does.
enum DeviceDirection {
  IN
  OUT
  BOTH

  @@map("device_direction")
}

enum PunchDirection {
  IN
  OUT

  @@map("punch_direction")
}

enum DeviceCommandKind {
  USER_UPSERT
  USER_DELETE

  @@map("device_command_kind")
}

enum DeviceCommandStatus {
  PENDING
  SENT
  DONE
  FAILED
  CANCELLED

  @@map("device_command_status")
}

/// What processing did with a punch.
enum PunchOutcome {
  APPLIED
  /// The device user id belongs to nobody in device_people.
  UNMAPPED
  /// The person is inactive or deleted.
  IGNORED
  /// Older than 7 days: shown, not applied.
  STALE
  /// Over the per-minute cap (BURST): counts only once an admin accepts it.
  HELD

  @@map("punch_outcome")
}

/// An admin's review of a flagged or held punch.
enum PunchReview {
  /// Looks right: cleared from review.
  OK
  /// A held punch accepted: it is applied.
  ACCEPTED
  /// It stops counting.
  REJECTED

  @@map("punch_review")
}

/// A device of an institute. A serial number is active in one institute at most; a device is
/// deactivated, never deleted (its punches stay).
model AttendanceDevice {
  id               String          @id @default(uuid(7)) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  brand            DeviceBrand     @default(ZKTECO)
  /// Upper case letters and digits, 6–32 (CHECK).
  serialNo         String          @map("serial_no")
  name             String
  gate             String?
  direction        DeviceDirection
  isActive         Boolean         @default(true) @map("is_active")
  // Written by the receiver only.
  lastSeenAt       DateTime?       @map("last_seen_at") @db.Timestamptz(3)
  lastPunchAt      DateTime?       @map("last_punch_at") @db.Timestamptz(3)
  lastIp           String?         @map("last_ip") @db.Inet
  firmware         String?
  userCount        Int?            @map("user_count")
  pushVersion      String?         @map("push_version")
  /// The ATTLOG stamp sent back at the next handshake.
  attlogStamp      String?         @map("attlog_stamp")
  /// Device clock minus ours (seconds), once its samples agree; subtracted from punch times.
  clockOffsetSec   Int?            @map("clock_offset_sec")
  /// The latest clock samples, at most 5.
  clockSamples     Int[]           @default([]) @map("clock_samples")
  /// The last minute with more than 5 × the per-minute cap, and how many punches were dropped.
  lastFloodAt      DateTime?       @map("last_flood_at") @db.Timestamptz(3)
  lastFloodDropped Int?            @map("last_flood_dropped")
  createdById      String?         @map("created_by_id") @db.Uuid
  updatedById      String?         @map("updated_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User?            @relation("AttendanceDeviceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User?            @relation("AttendanceDeviceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  commands  DeviceCommand[]
  punches   DevicePunch[]
  sourceIps DeviceSourceIp[]

  @@unique([tenantId, id])
  /// Across institutes: an active serial number belongs to one institute.
  @@unique([serialNo], map: "attendance_devices_active_serial", where: raw("is_active"))
  /// Any serial number, active or not: the receiver's refusals look up unknown and inactive ones.
  @@index([serialNo])
  @@map("attendance_devices")
}

/// A person's ID on the institute's devices (the same on each). One table for students and staff,
/// so one unique index keeps an ID to one person of either kind.
model DevicePerson {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// 100–999999999, digits only, no leading zero (CHECK).
  deviceUserId String   @map("device_user_id")
  /// Exactly one of student_id and staff_user_id is set (CHECK).
  studentId    String?  @map("student_id") @db.Uuid
  /// Composite to staff_profiles (tenant_id, user_id): only this institute's staff.
  staffUserId  String?  @map("staff_user_id") @db.Uuid
  createdById  String?  @map("created_by_id") @db.Uuid
  updatedById  String?  @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  student      Student?      @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  staffProfile StaffProfile? @relation(fields: [tenantId, staffUserId], references: [tenantId, userId], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?         @relation("DevicePersonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy    User?         @relation("DevicePersonUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  /// Students and staff together.
  @@unique([tenantId, deviceUserId])
  @@unique([tenantId, studentId], map: "device_people_one_per_student", where: raw("student_id IS NOT NULL"))
  @@unique([tenantId, staffUserId], map: "device_people_one_per_staff", where: raw("staff_user_id IS NOT NULL"))
  @@map("device_people")
}

/// A command waiting for, or sent to, one device: add or remove a person (PIN and name only).
model DeviceCommand {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  deviceId     String              @map("device_id") @db.Uuid
  /// The id on the wire (`C:<seq>:…`), from one sequence for all institutes.
  seq          BigInt              @unique @default(autoincrement())
  kind         DeviceCommandKind
  deviceUserId String              @map("device_user_id")
  /// The command after `C:<seq>:`; printable ASCII and tabs only, never a line break (CHECK).
  payload      String
  status       DeviceCommandStatus @default(PENDING)
  attempts     Int                 @default(0) @db.SmallInt
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz(3)
  doneAt       DateTime?           @map("done_at") @db.Timestamptz(3)
  /// The device's Return code (0 = done).
  returnCode   Int?                @map("return_code")
  createdById  String?             @map("created_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device    AttendanceDevice @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User?            @relation("DeviceCommandCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, deviceId, status])
  @@map("device_commands")
}

/// A raw punch as the device sent it. Immutable: the receiver inserts it; the app records only
/// processing and review, and deletes it after the retention period (never within 30 days).
model DevicePunch {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  deviceId     String         @map("device_id") @db.Uuid
  /// The PIN as sent; it may name nobody in device_people.
  deviceUserId String         @map("device_user_id")
  /// Wall-clock time as the device sent it, without a zone.
  deviceTime   DateTime       @map("device_time") @db.Timestamp(0)
  /// The time the rules use: device_time in the institute's zone, clock-corrected.
  punchedAt    DateTime       @map("punched_at") @db.Timestamptz(3)
  /// punched_at's day in the institute's zone.
  localDate    DateTime       @map("local_date") @db.Date
  receivedAt   DateTime       @map("received_at") @db.Timestamptz(3)
  /// Raw codes from the device (the verify numbering differs by firmware).
  verifyType   Int?           @map("verify_type") @db.SmallInt
  state        Int?           @db.SmallInt
  direction    PunchDirection
  /// A subset of CLOCK_CORRECTED, CLOCK_FUTURE, STALE, NEW_IP, OUTSIDE_HOURS, BURST (CHECK).
  flags        String[]       @default([])
  sourceIp     String?        @map("source_ip") @db.Inet
  /// Set together by the processing job.
  processedAt  DateTime?      @map("processed_at") @db.Timestamptz(3)
  outcome      PunchOutcome?
  /// NULL: not reviewed. Set together with reviewed_at.
  review       PunchReview?
  reviewedById String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device     AttendanceDevice @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy User?            @relation("DevicePunchReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  /// The dedupe: a punch the device sends again is not stored twice.
  @@unique([tenantId, deviceId, deviceUserId, deviceTime])
  @@index([tenantId, localDate, deviceUserId])
  /// The live feed.
  @@index([tenantId, receivedAt(sort: Desc)])
  /// The per-minute cap counts a device's punches by minute.
  @@index([tenantId, deviceId, deviceTime])
  /// The processing job's queue.
  @@index([tenantId, receivedAt], map: "device_punches_unprocessed", where: raw("processed_at IS NULL"))
  @@map("device_punches")
}

/// An address a device has uploaded from. The first is trusted automatically (trusted_by_id NULL);
/// punches from an untrusted one get the NEW_IP flag until an admin trusts it.
model DeviceSourceIp {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  ip          String    @db.Inet
  firstSeenAt DateTime  @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime  @map("last_seen_at") @db.Timestamptz(3)
  punchCount  Int       @default(0) @map("punch_count")
  trustedAt   DateTime? @map("trusted_at") @db.Timestamptz(3)
  trustedById String?   @map("trusted_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device    AttendanceDevice @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  trustedBy User?            @relation("DeviceSourceIpTrustedBy", fields: [trustedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, deviceId, ip])
  @@map("device_source_ips")
}

// ───────────────────────────── Staff attendance (step 11) ─────────────────────────────

enum StaffDayStatus {
  PRESENT
  ABSENT
  LEAVE

  @@map("staff_day_status")
}

/// One staff member's day: in and out times, minutes late and early, judged by that day's office
/// hours. Written by the device job (DEVICE) or an admin with a reason (MANUAL); never deleted.
model StaffAttendanceDay {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  /// Composite to staff_profiles (tenant_id, user_id): only this institute's staff.
  userId       String           @map("user_id") @db.Uuid
  date         DateTime         @db.Date
  status       StaffDayStatus
  /// Only a PRESENT day has times, and always an in time; out is never before in (CHECKs).
  inAt         DateTime?        @map("in_at") @db.Timestamptz(3)
  outAt        DateTime?        @map("out_at") @db.Timestamptz(3)
  /// The office hours the day was judged by, copied, so a later change keeps past days as judged.
  officeStart  DateTime         @map("office_start") @db.Time(0)
  officeEnd    DateTime         @map("office_end") @db.Time(0)
  lateMinutes  Int              @default(0) @map("late_minutes") @db.SmallInt
  earlyMinutes Int              @default(0) @map("early_minutes") @db.SmallInt
  /// DEVICE writes PRESENT, or ABSENT once a review rejected every punch; never LEAVE (CHECK).
  source       AttendanceSource
  /// MANUAL: required, 3–200 characters, with updated_by_id (CHECK).
  reason       String?
  updatedById  String?          @map("updated_by_id") @db.Uuid
  /// Optimistic concurrency: a manual change names the version it was based on.
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  staffProfile StaffProfile @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Restrict, onUpdate: Restrict)
  updatedBy    User?        @relation("StaffAttendanceDayUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  /// One row per person per day.
  @@unique([tenantId, userId, date])
  @@index([tenantId, date])
  @@map("staff_attendance_days")
}

// ───────────────────────────── Files and the institute profile (sprint 1 P2) ─────────────────────────────
// docs/files.md. Only apps/api/src/files/postgres-file-store.ts reads or writes stored_files and
// stored_file_usage (a code scan checks it); callers use the FileStore interface.

enum StoredFileKind {
  STUDENT_PHOTO
  APPLICANT_PHOTO
  LOGO
  SIGNATURE
  SEAL
  DOCUMENT_ASSET

  @@map("stored_file_kind")
}

/// An image stored in the database, already re-encoded by the API (never the uploaded bytes).
/// Rows never change (no UPDATE grant): a replaced image is a new row, and the old one is deleted.
model StoredFile {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  kind        StoredFileKind
  /// image/jpeg, image/png or image/webp; the CHECK pairs each kind with its formats.
  mime        String
  bytes       Bytes
  /// = octet_length(bytes); at most the kind's cap (CHECK).
  sizeBytes   Int            @map("size_bytes")
  /// Hex SHA-256 of bytes: the ETag.
  sha256      String         @db.Char(64)
  width       Int
  height      Int
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User?  @relation("StoredFileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Restrict)

  student          Student?          @relation("StudentPhoto")
  profileLogo      InstituteProfile? @relation("InstituteProfileLogo")
  profileSignature InstituteProfile? @relation("InstituteProfileSignature")
  profileSeal      InstituteProfile? @relation("InstituteProfileSeal")

  @@unique([tenantId, id])
  // What the kind-bound foreign keys point at.
  @@unique([tenantId, id, kind])
  @@index([tenantId, kind])
  @@map("stored_files")
}

/// One row per institute once it stores a file: the running total for the per-institute cap
/// (FILE_STORAGE_PER_TENANT_MB), changed with every put and delete under the institute's lock.
model StoredFileUsage {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  bytesUsed BigInt   @default(0) @map("bytes_used")
  fileCount Int      @default(0) @map("file_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@map("stored_file_usage")
}

/// The institute's own profile (at most one per institute, created on the first save or image).
/// tenants.name stays the name the platform registered; these are the institute's own words.
model InstituteProfile {
  id                  String         @id @default(uuid(7)) @db.Uuid
  tenantId            String         @unique @map("tenant_id") @db.Uuid
  nameBn              String?        @map("name_bn")
  nameEn              String?        @map("name_en")
  shortName           String?        @map("short_name")
  /// BANBEIS EIIN: 6 ASCII digits.
  eiin                String?
  addressBn           String?        @map("address_bn")
  addressEn           String?        @map("address_en")
  /// 5-15 ASCII digits with an optional leading + (a Bangladeshi mobile is stored as E.164).
  phone               String?
  email               String?
  website             String?
  headTitleBn         String?        @map("head_title_bn")
  headTitleEn         String?        @map("head_title_en")
  headNameBn          String?        @map("head_name_bn")
  headNameEn          String?        @map("head_name_en")
  establishedYear     Int?           @map("established_year") @db.SmallInt
  logoFileId          String?        @map("logo_file_id") @db.Uuid
  headSignatureFileId String?        @map("head_signature_file_id") @db.Uuid
  sealFileId          String?        @map("seal_file_id") @db.Uuid
  /// Fixed kinds (CHECK institute_profiles_file_kinds), part of each image's foreign key, so a
  /// logo is a LOGO file, the signature a SIGNATURE and the seal a SEAL.
  logoFileKind        StoredFileKind @default(LOGO) @map("logo_file_kind")
  signatureFileKind   StoredFileKind @default(SIGNATURE) @map("head_signature_file_kind")
  sealFileKind        StoredFileKind @default(SEAL) @map("seal_file_kind")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  logoFile      StoredFile? @relation("InstituteProfileLogo", fields: [tenantId, logoFileId, logoFileKind], references: [tenantId, id, kind], onDelete: Restrict, onUpdate: Restrict)
  signatureFile StoredFile? @relation("InstituteProfileSignature", fields: [tenantId, headSignatureFileId, signatureFileKind], references: [tenantId, id, kind], onDelete: Restrict, onUpdate: Restrict)
  sealFile      StoredFile? @relation("InstituteProfileSeal", fields: [tenantId, sealFileId, sealFileKind], references: [tenantId, id, kind], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  // One file is used in one place (also each foreign key's index).
  @@unique([tenantId, logoFileId, logoFileKind])
  @@unique([tenantId, headSignatureFileId, signatureFileKind])
  @@unique([tenantId, sealFileId, sealFileKind])
  @@map("institute_profiles")
}

// ───────────────────── Online admission (sprint 1 P3, docs/admission.md) ─────────────────────

enum AdmissionCycleStatus {
  DRAFT
  OPEN
  CLOSED

  @@map("admission_cycle_status")
}

enum AdmissionApplicationStatus {
  SUBMITTED
  SHORTLISTED
  SELECTED
  WAITLISTED
  REJECTED
  ADMITTED
  WITHDRAWN

  @@map("admission_application_status")
}

/// Where an application came from: the public form, or staff typing a walk-in (decision P3-J).
enum AdmissionSource {
  ONLINE
  STAFF

  @@map("admission_source")
}

/// How applicants with the same test score are ordered (decision P4-A).
enum AdmissionTieBreak {
  OLDER_FIRST
  YOUNGER_FIRST
  NONE

  @@map("admission_tie_break")
}

/// The draft outcome of the last merit list build (P4); statuses change only at publish.
enum AdmissionTestResult {
  SELECTED
  WAITLISTED
  NOT_SELECTED
  FAILED
  ABSENT

  @@map("admission_test_result")
}

/// An admission window for one academic year (usually the next one).
model AdmissionCycle {
  id             String               @id @default(uuid(7)) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  academicYearId String               @map("academic_year_id") @db.Uuid
  nameBn         String               @map("name_bn")
  nameEn         String?              @map("name_en")
  status         AdmissionCycleStatus @default(DRAFT)
  /// The public form takes applications while opens_at <= now < closes_at (and status OPEN).
  opensAt        DateTime             @map("opens_at") @db.Timestamptz(3)
  closesAt       DateTime             @map("closes_at") @db.Timestamptz(3)
  publicNoteBn   String?              @map("public_note_bn")
  publicNoteEn   String?              @map("public_note_en")
  /// An admission test decides who is SELECTED (P4).
  requiresTest   Boolean              @default(false) @map("requires_test")
  /// The form asks for the applicant's photo (S9).
  collectPhoto   Boolean              @default(false) @map("collect_photo")
  /// { <field>: "HIDDEN" | "OPTIONAL" | "REQUIRED" } for the optional form fields (CHECK).
  fields         Json                 @default("{}") @db.JsonB
  /// How equal test scores are ordered in the merit list (P4).
  meritTieBreak  AdmissionTieBreak    @default(OLDER_FIRST) @map("merit_tie_break")
  /// The admin who made it (no FK: users are global, as audit_logs.user_id).
  createdBy      String?              @map("created_by") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  academicYear AcademicYear           @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  classes      AdmissionCycleClass[]
  applications AdmissionApplication[]

  @@unique([tenantId, id])
  @@index([tenantId, academicYearId, status])
  @@map("admission_cycles")
}

/// A class (and group) a cycle takes applications for.
model AdmissionCycleClass {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  cycleId            String    @map("cycle_id") @db.Uuid
  classLevelId       String    @map("class_level_id") @db.Uuid
  studyGroupId       String?   @map("study_group_id") @db.Uuid
  /// Shown to staff only; NULL: no limit.
  seats              Int?
  isOpen             Boolean   @default(true) @map("is_open")
  // ── The admission test (P4); the time is the institute's local time.
  testDate           DateTime? @map("test_date") @db.Date
  testTime           DateTime? @map("test_time") @db.Time(0)
  testVenueBn        String?   @map("test_venue_bn")
  testVenueEn        String?   @map("test_venue_en")
  fullMarks          Int?      @map("full_marks")
  passMarks          Int?      @map("pass_marks")
  selectCount        Int?      @map("select_count")
  waitlistCount      Int?      @map("waitlist_count")
  /// The draft merit list: when it was built and a hash of what it was built from.
  meritBuiltAt       DateTime? @map("merit_built_at") @db.Timestamptz(3)
  meritInputsHash    String?   @map("merit_inputs_hash")
  /// The latest score change (the list shows "changed since publish").
  scoresChangedAt    DateTime? @map("scores_changed_at") @db.Timestamptz(3)
  /// The published version (0: never published), when, and its full marks.
  resultsVersion     Int       @default(0) @map("results_version")
  resultsPublishedAt DateTime? @map("results_published_at") @db.Timestamptz(3)
  resultsFullMarks   Int?      @map("results_full_marks")
  /// The build the published version came from (never published twice).
  resultsBuiltAt     DateTime? @map("results_built_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle        AdmissionCycle         @relation(fields: [tenantId, cycleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  classLevel   ClassLevel             @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  studyGroup   StudyGroup?            @relation(fields: [tenantId, studyGroupId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  applications AdmissionApplication[]

  @@unique([tenantId, id])
  /// What the applications' composite FK points at: an application's class belongs to its cycle.
  @@unique([tenantId, id, cycleId])
  @@unique([tenantId, cycleId, classLevelId, studyGroupId])
  /// The same class without a group once per cycle (NULL groups never clash in the unique above).
  @@unique([tenantId, cycleId, classLevelId], map: "admission_cycle_classes_one_without_group", where: raw("study_group_id IS NULL"))
  @@index([tenantId, cycleId])
  @@map("admission_cycle_classes")
}

/// One child's application. History: never deleted; a status change keeps who, when and why.
model AdmissionApplication {
  id                     String                     @id @default(uuid(7)) @db.Uuid
  tenantId               String                     @map("tenant_id") @db.Uuid
  cycleId                String                     @map("cycle_id") @db.Uuid
  cycleClassId           String                     @map("cycle_class_id") @db.Uuid
  /// <year>-<NNNN>, unique per institute (decision P3-G).
  applicationNo          String                     @map("application_no")
  source                 AdmissionSource
  nameBn                 String?                    @map("name_bn")
  nameEn                 String?                    @map("name_en")
  /// Lower-cased NFC name without spaces, for duplicate checks.
  nameKey                String                     @map("name_key")
  dateOfBirth            DateTime                   @map("date_of_birth") @db.Date
  gender                 Gender
  religion               Religion?
  bloodGroup             BloodGroup?                @map("blood_group")
  birthRegistrationNo    String?                    @map("birth_registration_no")
  /// Kept on the application only (decision P3-I).
  previousInstitute      String?                    @map("previous_institute")
  presentAddress         String?                    @map("present_address")
  permanentAddress       String?                    @map("permanent_address")
  fatherNameBn           String?                    @map("father_name_bn")
  fatherNameEn           String?                    @map("father_name_en")
  motherNameBn           String?                    @map("mother_name_bn")
  motherNameEn           String?                    @map("mother_name_en")
  guardianNameBn         String?                    @map("guardian_name_bn")
  guardianNameEn         String?                    @map("guardian_name_en")
  guardianRelation       GuardianRelation           @map("guardian_relation")
  /// Kept on the application; becomes the guardian's occupation at approval.
  guardianOccupation     String?                    @map("guardian_occupation")
  /// The applicant's (guardian's) phone, E.164.
  phone                  String
  status                 AdmissionApplicationStatus @default(SUBMITTED)
  statusReason           String?                    @map("status_reason")
  statusBy               String?                    @map("status_by") @db.Uuid
  statusAt               DateTime?                  @map("status_at") @db.Timestamptz(3)
  staffNote              String?                    @map("staff_note")
  /// The student made from it (status ADMITTED, and only then).
  studentId              String?                    @map("student_id") @db.Uuid
  /// Why bulk approval skipped it (decision P3-T).
  approvalProblem        String?                    @map("approval_problem")
  approvalProblemAt      DateTime?                  @map("approval_problem_at") @db.Timestamptz(3)
  // ── The admission test (P4). A score in hundredths, within the class's full marks (trigger).
  testRoll               Int?                       @map("test_roll")
  testScoreH             Int?                       @map("test_score_h")
  testAbsent             Boolean                    @default(false) @map("test_absent")
  /// The draft of the last build: never shown to the applicant.
  testResult             AdmissionTestResult?       @map("test_result")
  meritPosition          Int?                       @map("merit_position")
  waitlistPosition       Int?                       @map("waitlist_position")
  /// The published snapshot (the only result columns the public lookup reads).
  resultVersion          Int?                       @map("result_version")
  resultMeritPosition    Int?                       @map("result_merit_position")
  resultWaitlistPosition Int?                       @map("result_waitlist_position")
  resultScoreH           Int?                       @map("result_score_h")
  resultAbsent           Boolean?                   @map("result_absent")
  /// ADMITTED_NOT_SELECTED: admitted, but a corrected list would not select them (P4-F).
  resultFlag             String?                    @map("result_flag")
  submittedAt            DateTime                   @map("submitted_at") @db.Timestamptz(3)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle      AdmissionCycle             @relation(fields: [tenantId, cycleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  cycleClass AdmissionCycleClass        @relation(fields: [tenantId, cycleClassId, cycleId], references: [tenantId, id, cycleId], onDelete: Restrict, onUpdate: Restrict)
  student    Student?                   @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  photo      AdmissionApplicationPhoto?

  @@unique([tenantId, id])
  @@unique([tenantId, applicationNo])
  @@unique([tenantId, studentId])
  /// One live application per birth registration number per cycle (the duplicate rule).
  @@unique([tenantId, cycleId, birthRegistrationNo], map: "admission_applications_birth_reg_live", where: raw("birth_registration_no IS NOT NULL AND status <> 'WITHDRAWN'"))
  /// One test roll per class (P4-C).
  @@unique([tenantId, cycleClassId, testRoll], map: "admission_applications_test_roll_key", where: raw("test_roll IS NOT NULL"))
  @@index([tenantId, cycleId, status])
  @@index([tenantId, phone])
  @@index([tenantId, cycleClassId])
  @@index([tenantId, cycleClassId, meritPosition], map: "admission_applications_merit_idx")
  @@map("admission_applications")
}

/// An applicant's photo until approval moves it into stored_files (decision P3-B). A re-encoded
/// JPEG only, never the uploaded bytes.
model AdmissionApplicationPhoto {
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  mime          String
  bytes         Bytes
  sha256        String
  width         Int      @db.SmallInt
  height        Int      @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  application AdmissionApplication @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, applicationId])
  @@map("admission_application_photos")
}

/// The last application number per institute and year (numbers are <year>-<NNNN>).
model AdmissionCounter {
  tenantId  String   @map("tenant_id") @db.Uuid
  year      Int      @db.SmallInt
  lastNo    Int      @default(0) @map("last_no")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, year])
  @@map("admission_counters")
}

// ───────────────────────────── Promotion and new session (sprint 1 P5) ─────────────────────────────
// A run per class moves its students into the next academic year (docs/promotion.md). Rows are
// edited while pending; an applied row never changes again (restrictive policies, migration
// 20261117200100_promotion_runs).

/// How rolls are proposed for a group of students in the new year (assignRolls, @jantrik/shared).
enum PromotionRollStrategy {
  MERIT
  NAME_BN
  NAME_EN
  MANUAL
  KEEP

  @@map("promotion_roll_strategy")
}

/// DRAFT (rows edited) → APPLYING (the job runs, or stopped with last_error) → APPLIED (no pending
/// row left). Rows added by a refresh after APPLIED are applied by another apply.
enum PromotionRunStatus {
  DRAFT
  APPLYING
  APPLIED

  @@map("promotion_run_status")
}

enum PromotionDecision {
  PROMOTE
  REPEAT
  LEAVE

  @@map("promotion_decision")
}

/// What applying a row did: a new enrolment, an enrolment that was already there (left as is,
/// P5-D), the student marked as leaving, or nothing because the student was deactivated or had
/// already left (another way) meanwhile.
enum PromotionApplyOutcome {
  ENROLLED
  ALREADY_ENROLLED
  LEFT
  SKIPPED_DEACTIVATED
  SKIPPED_LEFT

  @@map("promotion_apply_outcome")
}

/// One promotion run: a from-class of the from-year moving into the to-year. History once applied
/// (no DELETE grant); a draft is emptied, never deleted (P5-L).
model PromotionRun {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  fromYearId     String                @map("from_year_id") @db.Uuid
  toYearId       String                @map("to_year_id") @db.Uuid
  /// The from-class.
  classLevelId   String                @map("class_level_id") @db.Uuid
  rollStrategy   PromotionRollStrategy @map("roll_strategy")
  /// A published exam of the from-year (defaults and merit order); checked against the from-year.
  meritExamId    String?               @map("merit_exam_id") @db.Uuid
  status         PromotionRunStatus    @default(DRAFT)
  createdById    String                @map("created_by_id") @db.Uuid
  /// The admin who pressed apply last (the job acts as them).
  appliedById    String?               @map("applied_by_id") @db.Uuid
  applyStartedAt DateTime?             @map("apply_started_at") @db.Timestamptz(3)
  /// Set when no pending row is left.
  appliedAt      DateTime?             @map("applied_at") @db.Timestamptz(3)
  /// A fixed code (SECTION_FULL, ACTOR_NOT_ADMIN, ERROR…), never a message.
  lastError      String?               @map("last_error")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromYear   AcademicYear @relation("PromotionRunFromYear", fields: [tenantId, fromYearId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  toYear     AcademicYear @relation("PromotionRunToYear", fields: [tenantId, toYearId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  classLevel ClassLevel   @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  meritExam  Exam?        @relation(fields: [tenantId, meritExamId, fromYearId], references: [tenantId, id, academicYearId], onDelete: Restrict, onUpdate: Restrict)
  createdBy  User         @relation("PromotionRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  appliedBy  User?        @relation("PromotionRunAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  rows PromotionRunStudent[]

  @@unique([tenantId, id])
  /// The rows' target: a row carries its run's to-year, so its target section can be checked.
  @@unique([tenantId, id, toYearId])
  @@unique([tenantId, fromYearId, toYearId, classLevelId])
  @@index([tenantId, toYearId])
  @@map("promotion_runs")
}

/// One student of a run: the snapshot when the run was made, the decision and target, and what
/// applying it did. Updated and deleted only while pending (applied_at NULL).
model PromotionRunStudent {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  runId              String                 @map("run_id") @db.Uuid
  /// Copied from the run, so the target section can be checked by a foreign key.
  toYearId           String                 @map("to_year_id") @db.Uuid
  studentId          String                 @map("student_id") @db.Uuid
  fromEnrolmentId    String                 @map("from_enrolment_id") @db.Uuid
  fromSectionId      String?                @map("from_section_id") @db.Uuid
  fromRoll           Int?                   @map("from_roll")
  /// From the merit exam; NULL = no result.
  resultPassed       Boolean?               @map("result_passed")
  /// The class position in the merit exam; NULL = unranked or no result.
  meritPosition      Int?                   @map("merit_position")
  decision           PromotionDecision
  targetClassLevelId String?                @map("target_class_level_id") @db.Uuid
  targetSectionId    String?                @map("target_section_id") @db.Uuid
  targetStudyGroupId String?                @map("target_study_group_id") @db.Uuid
  leaveStatus        StudentStatus?         @map("leave_status")
  leftOn             DateTime?              @map("left_on") @db.Date
  leaveReason        String?                @map("leave_reason")
  appliedAt          DateTime?              @map("applied_at") @db.Timestamptz(3)
  applyOutcome       PromotionApplyOutcome? @map("apply_outcome")
  toEnrolmentId      String?                @map("to_enrolment_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  run              PromotionRun @relation(fields: [tenantId, runId, toYearId], references: [tenantId, id, toYearId], onDelete: Restrict, onUpdate: Restrict)
  student          Student      @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  fromEnrolment    Enrolment    @relation("PromotionRowFromEnrolment", fields: [tenantId, fromEnrolmentId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  fromSection      Section?     @relation("PromotionRowFromSection", fields: [tenantId, fromSectionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  targetClassLevel ClassLevel?  @relation(fields: [tenantId, targetClassLevelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  targetSection    Section?     @relation("PromotionRowTargetSection", fields: [tenantId, targetSectionId, toYearId, targetClassLevelId], references: [tenantId, id, academicYearId, classLevelId], onDelete: Restrict, onUpdate: Restrict)
  targetStudyGroup StudyGroup?  @relation(fields: [tenantId, targetStudyGroupId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  toEnrolment      Enrolment?   @relation("PromotionRowToEnrolment", fields: [tenantId, toEnrolmentId, studentId, toYearId], references: [tenantId, id, studentId, academicYearId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, runId, studentId])
  /// A student is in at most one run into a given year.
  @@unique([tenantId, toYearId, studentId])
  @@index([tenantId, runId, targetSectionId])
  @@index([tenantId, toYearId, targetClassLevelId])
  @@index([tenantId, studentId])
  @@map("promotion_run_students")
}

// ───────────────────────────── Notices (sprint 1 P6, docs/notices.md) ─────────────────────────────

enum NoticeAudience {
  ALL
  STAFF
  GUARDIANS

  @@map("notice_audience")
}

/// "Scheduled" is a PUBLISHED notice whose publish_at is still ahead (P6-A): visibility is computed
/// when read, so no job flips it.
enum NoticeStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN

  @@map("notice_status")
}

/// A notice on the board. Never deleted (withdrawn instead); OWNER/ADMIN write it (S20).
model Notice {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  title           String
  body            String
  audience        NoticeAudience
  status          NoticeStatus   @default(DRAFT)
  publishAt       DateTime?      @map("publish_at") @db.Timestamptz(3)
  expiresAt       DateTime?      @map("expires_at") @db.Timestamptz(3)
  pinned          Boolean        @default(false)
  createdById     String         @map("created_by_id") @db.Uuid
  publishedById   String?        @map("published_by_id") @db.Uuid
  withdrawnById   String?        @map("withdrawn_by_id") @db.Uuid
  withdrawnAt     DateTime?      @map("withdrawn_at") @db.Timestamptz(3)
  withdrawnReason String?        @map("withdrawn_reason")
  /// The last edit after publishing ("edited" on the board, P6-N).
  editedAt        DateTime?      @map("edited_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   User           @relation("NoticeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedBy User?          @relation("NoticePublishedBy", fields: [publishedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  withdrawnBy User?          @relation("NoticeWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targets     NoticeTarget[]
  reads       NoticeRead[]
  broadcasts  SmsBroadcast[]

  @@unique([tenantId, id])
  @@index([tenantId, status, publishAt(sort: Desc)])
  @@map("notices")
}

/// Narrows a notice's guardians to some classes (or one section of a class); none = everyone of
/// the audience. Staff see an ALL or STAFF notice whatever its targets (P6-G). Replaced whole on
/// save (delete + insert), so there is no UPDATE.
model NoticeTarget {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  noticeId     String   @map("notice_id") @db.Uuid
  classLevelId String   @map("class_level_id") @db.Uuid
  sectionId    String?  @map("section_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notice     Notice     @relation(fields: [tenantId, noticeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  classLevel ClassLevel @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// A section of that class.
  section    Section?   @relation(fields: [tenantId, sectionId, classLevelId], references: [tenantId, id, classLevelId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, noticeId])
  @@map("notice_targets")
}

/// Who read a notice. Only for oneself (a restrictive policy); history: no UPDATE, no DELETE.
model NoticeRead {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  noticeId String   @map("notice_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  readAt   DateTime @default(now()) @map("read_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notice Notice @relation(fields: [tenantId, noticeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, noticeId, userId])
  @@index([tenantId, userId])
  @@map("notice_reads")
}

enum BroadcastRecipients {
  PRIMARY_GUARDIANS
  ALL_GUARDIANS
  STAFF

  @@map("broadcast_recipients")
}

/// SENT means every SMS was handed to the SMS queue (in one transaction); delivery is read live
/// from sms_logs (P6-C). FAILED_OVER_CAP: nothing was sent (all or nothing, S18).
enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
  FAILED_OVER_CAP
  /// Found more than 3 hours late (its job was lost): not sent; a new preview and send is needed.
  EXPIRED
  /// At send time it would cost much more than confirmed (the audience grew): not sent.
  COST_CHANGED

  @@map("broadcast_status")
}

/// An SMS to guardians or staff, sent now or at a set time, whole or not at all (S18–S20). Never
/// deleted (money history).
model SmsBroadcast {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  body               String
  noticeId           String?             @map("notice_id") @db.Uuid
  recipients         BroadcastRecipients
  status             BroadcastStatus     @default(DRAFT)
  scheduledAt        DateTime?           @map("scheduled_at") @db.Timestamptz(3)
  /// The recipient count the admin confirmed (an estimate: the audience is resolved at send, S19).
  previewCount       Int?                @map("preview_count")
  segments           Int?                @db.SmallInt
  estimatedCostPaisa Int?                @map("estimated_cost_paisa")
  queuedCount        Int?                @map("queued_count")
  /// The real cost of what was queued (SENT), integer paisa.
  sentCostPaisa      Int?                @map("sent_cost_paisa")
  /// The institute's day it was sent (cap and billing).
  localDate          DateTime?           @map("local_date") @db.Date
  createdById        String              @map("created_by_id") @db.Uuid
  /// The admin the send job acts for.
  scheduledById      String?             @map("scheduled_by_id") @db.Uuid
  sentAt             DateTime?           @map("sent_at") @db.Timestamptz(3)
  cancelledById      String?             @map("cancelled_by_id") @db.Uuid
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  /// BY_ADMIN or ACTOR_NOT_ADMIN.
  cancelReason       String?             @map("cancel_reason")
  /// {needed, capLeft} for FAILED_OVER_CAP.
  failure            Json?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  notice      Notice?              @relation(fields: [tenantId, noticeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   User                 @relation("SmsBroadcastCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scheduledBy User?                @relation("SmsBroadcastScheduledBy", fields: [scheduledById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy User?                @relation("SmsBroadcastCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targets     SmsBroadcastTarget[]

  @@unique([tenantId, id])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, noticeId])
  @@map("sms_broadcasts")
}

/// A broadcast's guardian targets (as notice_targets): a class, or a section of that class.
model SmsBroadcastTarget {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  broadcastId  String   @map("broadcast_id") @db.Uuid
  classLevelId String   @map("class_level_id") @db.Uuid
  sectionId    String?  @map("section_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  broadcast  SmsBroadcast @relation(fields: [tenantId, broadcastId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  classLevel ClassLevel   @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  section    Section?     @relation(fields: [tenantId, sectionId, classLevelId], references: [tenantId, id, classLevelId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, broadcastId])
  @@map("sms_broadcast_targets")
}

// ───────────────────────────── Online payments (sprint 1 P7a, docs/payments.md) ─────────────────────────────

/// The online payment gateway an account belongs to (BKASH_TOKENIZED later, in its own migration).
enum PaymentProvider {
  SSLCOMMERZ

  @@map("payment_provider")
}

/// An institute's gateway account: one per provider, SANDBOX only this sprint. The store ID and
/// password are one AES-256-GCM ciphertext bound to this row (AAD payments:<provider>:<tenant>:<id>),
/// left out of every read unless asked (CLIENT_OMIT) and read only by PaymentCredentialsService.
/// On only after a passing test; saving credentials switches it off. Never deleted (P7a-P).
model PaymentGatewayAccount {
  id                     String          @id @default(uuid(7)) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  provider               PaymentProvider
  /// SANDBOX only (a CHECK); live mode is a later decision.
  mode                   String          @default("SANDBOX")
  enabled                Boolean         @default(false)
  /// "v1." + base64url(iv | tag | ciphertext) of {"storeId","storePassword"}.
  credentialsCiphertext  String?         @map("credentials_ciphertext")
  /// The store ID's last 4 characters, shown to the owner (never the password).
  credentialsHint        String?         @map("credentials_hint")
  keyVersion             Int             @default(1) @map("key_version") @db.SmallInt
  credentialsUpdatedAt   DateTime?       @map("credentials_updated_at") @db.Timestamptz(3)
  /// NULL when a command loaded them (payments:load-sandbox): no person did.
  credentialsUpdatedById String?         @map("credentials_updated_by_id") @db.Uuid
  lastTestAt             DateTime?       @map("last_test_at") @db.Timestamptz(3)
  /// OK, BAD_CREDENTIALS, STORE_INACTIVE, UNREACHABLE or ERROR.
  lastTestResult         String?         @map("last_test_result")
  lastTestedById         String?         @map("last_tested_by_id") @db.Uuid
  /// The last failure of a job that used the account (a fixed code), shown to the owner.
  lastFailureCode        String?         @map("last_failure_code")
  lastFailureAt          DateTime?       @map("last_failure_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credentialsUpdatedBy User?           @relation("PaymentAccountCredentialsUpdatedBy", fields: [credentialsUpdatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lastTestedBy         User?           @relation("PaymentAccountTestedBy", fields: [lastTestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  intents              PaymentIntent[]

  @@unique([tenantId, id])
  @@unique([tenantId, provider])
  @@map("payment_gateway_accounts")
}

/// What an online payment attempt is (docs/payments.md → States). REFUNDED_OUTSIDE and DISMISSED
/// are P7b's review outcomes, created now (P7a-T); nothing in P7a writes them.
enum PaymentIntentStatus {
  CREATED
  REDIRECTED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  NEEDS_REVIEW
  REFUNDED_OUTSIDE
  DISMISSED

  @@map("payment_intent_status")
}

/// Why an intent or a gateway event waits for a person (S23). VOIDED: an admin voided the
/// posted payment (P7a-G).
enum PaymentReviewReason {
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  TRAN_ID_MISMATCH
  HIGH_RISK
  DUES_CHANGED
  LATE_SUCCESS
  DUPLICATE
  UNMATCHED
  VOIDED

  @@map("payment_review_reason")
}

/// INIT: the session; RETURN: the payer's browser; IPN: the gateway's notification; VALIDATE and
/// QUERY: our own questions to the gateway.
enum PaymentEventKind {
  INIT
  RETURN
  IPN
  VALIDATE
  QUERY

  @@map("payment_event_kind")
}

/// One online payment attempt by a guardian for chosen dues of one child, paid in full (S22). The
/// amount, our tran_id and the dues are fixed when it is created (grants by column); the money the
/// gateway reports is written once (trigger payment_intents_guard). PAID exactly when it holds a
/// live GATEWAY payment that names it (deferred triggers). Never deleted.
model PaymentIntent {
  id                   String                @id @default(uuid(7)) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  accountId            String                @map("account_id") @db.Uuid
  studentId            String                @map("student_id") @db.Uuid
  /// The guardian who started it (a global user, like a payment's collector).
  payerUserId          String                @map("payer_user_id") @db.Uuid
  /// ৳10 to ৳5 lakh (SSLCommerz's range, P7a-L).
  amountPaisa          Int                   @map("amount_paisa")
  currency             String                @default("BDT")
  /// The institute's day the amount was computed: the payment's paid_on (P7a-E).
  pricedOn             DateTime              @map("priced_on") @db.Date
  /// Ours: "JS" + 26 Crockford base32 characters (newTranId).
  tranId               String                @map("tran_id")
  clientRequestId      String                @map("client_request_id") @db.Uuid
  status               PaymentIntentStatus   @default(CREATED)
  /// SSLCommerz's sessionkey.
  sessionRef           String?               @map("session_ref")
  /// SSLCommerz's GatewayPageURL (its host checked by the client).
  checkoutUrl          String?               @map("checkout_url")
  /// A fixed code when the session could not be made.
  initError            String?               @map("init_error")
  /// The validated payment's facts, as the gateway's validation API reported them; written once.
  valId                String?               @map("val_id")
  bankTranId           String?               @map("bank_tran_id")
  /// SSLCommerz card_type (e.g. "BKASH-BKash").
  instrument           String?
  method               FeePaymentMethod?
  validatedAmountPaisa Int?                  @map("validated_amount_paisa")
  storeAmountPaisa     Int?                  @map("store_amount_paisa")
  /// currency_type as returned.
  validatedCurrency    String?               @map("validated_currency")
  /// LOW only for risk_level "0"; anything else HIGH.
  risk                 String?
  /// tran_date, read as Asia/Dhaka; shown only.
  gatewayPaidAt        DateTime?             @map("gateway_paid_at") @db.Timestamptz(3)
  feePaymentId         String?               @map("fee_payment_id") @db.Uuid
  /// Until then it blocks another checkout for the child (P7a-F).
  expiresAt            DateTime              @map("expires_at") @db.Timestamptz(3)
  reviewReasons        PaymentReviewReason[] @default([]) @map("review_reasons")
  reviewSince          DateTime?             @map("review_since") @db.Timestamptz(3)
  /// When it left CREATED/REDIRECTED.
  closedAt             DateTime?             @map("closed_at") @db.Timestamptz(3)
  /// P7b: a person's decision on it in review (apply, refunded outside, dismiss): who, when and
  /// why. Written only as it leaves NEEDS_REVIEW; cleared when it comes back (the audit log keeps
  /// the earlier one). Trigger payment_intents_resolution_guard.
  resolvedById         String?               @map("resolved_by_id") @db.Uuid
  resolvedAt           DateTime?             @map("resolved_at") @db.Timestamptz(3)
  /// 3 to 500 characters.
  resolutionNote       String?               @map("resolution_note")
  /// Applied: the amount of its payment; applied + refunded outside = the validated amount.
  appliedPaisa         Int?                  @map("applied_paisa")
  /// The part (or all) of the validated money recorded as given back outside the app.
  refundedOutsidePaisa Int?                  @map("refunded_outside_paisa")
  /// What the institute's own records call that refund (ASCII letters, digits, -_./).
  refundReference      String?               @map("refund_reference")
  /// The last time SSLCommerz was asked about it by our tran_id (reconciliation, "check now").
  lastCheckedAt        DateTime?             @map("last_checked_at") @db.Timestamptz(3)
  /// SUCCESS_FOUND, PENDING, NO_SUCCESS or the provider's error code.
  lastCheckOutcome     String?               @map("last_check_outcome")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account    PaymentGatewayAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  student    Student               @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payer      User                  @relation("PaymentIntentPayer", fields: [payerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy User?                 @relation("PaymentIntentResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Same student as the intent's.
  feePayment FeePayment?           @relation("PaymentIntentFeePayment", fields: [tenantId, feePaymentId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  dues       PaymentIntentDue[]
  events     PaymentGatewayEvent[]
  payments   FeePayment[]          @relation("FeePaymentIntent")

  @@unique([tenantId, id])
  /// Composite target for rows that must name the intent's own student (its dues, its payment).
  @@unique([tenantId, id, studentId])
  @@unique([tenantId, tranId])
  @@unique([tenantId, clientRequestId])
  @@unique([tenantId, feePaymentId])
  @@index([tenantId, studentId, status])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, payerUserId, createdAt])
  @@map("payment_intents")
}

/// A due an intent pays, with the principal and fine it owed on the intent's priced_on (the
/// snapshot the payment is checked against). An intent's rows add up to its amount (deferred
/// trigger). Append-only.
model PaymentIntentDue {
  id                    String   @id @default(uuid(7)) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  intentId              String   @map("intent_id") @db.Uuid
  studentId             String   @map("student_id") @db.Uuid
  dueId                 String   @map("due_id") @db.Uuid
  plannedPrincipalPaisa Int      @map("planned_principal_paisa")
  plannedFinePaisa      Int      @map("planned_fine_paisa")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Intent and due share the student: the child's own dues only.
  intent  PaymentIntent @relation(fields: [tenantId, intentId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  due     FeeDue        @relation(fields: [tenantId, dueId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict)
  student Student       @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, intentId, dueId])
  @@index([tenantId, dueId])
  @@map("payment_intent_dues")
}

/// Everything the gateway told us or we asked it, append-only (no UPDATE or DELETE for anyone).
/// RETURN and IPN rows are written by payment_signal_record (owner jantrik_payments) before any
/// context; the API writes INIT, VALIDATE and QUERY rows. fields: whitelisted strings only.
model PaymentGatewayEvent {
  id           String               @id @default(uuid(7)) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  /// NULL: it matched no intent of this institute.
  intentId     String?              @map("intent_id") @db.Uuid
  kind         PaymentEventKind
  /// RETURN: SUCCESS/FAIL/CANCEL (from the path, a hint only); INIT/VALIDATE/QUERY: the gateway's
  /// status or our error code.
  outcome      String?
  tranId       String?              @map("tran_id")
  valId        String?              @map("val_id")
  fields       Json                 @default("{}")
  /// RETURN/IPN: whether the sender's address is one SSLCommerz documents (P7a-C).
  sourceListed Boolean?             @map("source_listed")
  /// VALIDATE only: money with no intent to hold it (UNMATCHED) or a second payment (DUPLICATE).
  reviewReason PaymentReviewReason? @map("review_reason")
  receivedAt   DateTime             @map("received_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  intent PaymentIntent?       @relation(fields: [tenantId, intentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// P7b: the one final decision on a review event (UNMATCHED or DUPLICATE money).
  review PaymentSignalReview?

  @@unique([tenantId, id])
  @@index([tenantId, intentId, receivedAt])
  @@index([tenantId, tranId])
  @@index([tenantId, receivedAt], map: "payment_gateway_events_review", where: raw("review_reason IS NOT NULL"))
  @@map("payment_gateway_events")
}

/// P7b (decision P7b-C): the one final decision on money no intent holds or that came twice (a
/// VALIDATE event with a review reason): refunded outside the app, or dismissed as a repeat
/// record of money held elsewhere (deferred trigger). Append-only: SELECT and INSERT only.
model PaymentSignalReview {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  /// REFUNDED_OUTSIDE or DISMISSED (a CHECK).
  outcome         String
  /// REFUNDED_OUTSIDE: the event's validated amount (NULL when the gateway's amount was not a
  /// well-formed amount).
  amountPaisa     Int?     @map("amount_paisa")
  refundReference String?  @map("refund_reference")
  /// 3 to 500 characters.
  note            String
  resolvedById    String   @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  event      PaymentGatewayEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy User                @relation("PaymentSignalReviewResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  /// One decision per item, final.
  @@unique([tenantId, eventId])
  @@index([tenantId, resolvedAt])
  @@map("payment_signal_reviews")
}
