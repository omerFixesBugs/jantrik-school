// Prisma schema for Jantrik School — Phase 1 core.
// Read docs/database.md before adding a table.
//
// Conventions
// - UUIDv7 primary keys, snake_case in the DB (@map / @@map), created_at + updated_at everywhere
//   (audit_logs is append-only and has created_at only).
// - Tenant-owned tables: tenant_id NOT NULL, @@unique([tenantId, id]) and composite foreign keys
//   (tenant_id, x_id) for every reference to another tenant-owned table, so a row can never point
//   at another tenant's data. Row-Level Security is added in SQL migrations.
// - Global tables (institute types, templates, users) have no tenant_id and no RLS; the app role
//   can only read templates.
// - CHECK constraints, RLS policies and grants live in hand-written SQL migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // pg_trgm: trigram GIN indexes for substring search (students, guardians).
  extensions = [pg_trgm]
}

// ───────────────────────────── Enums ─────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("tenant_status")
}

enum Locale {
  bn
  en

  @@map("locale")
}

/// Product modules a tenant can enable. Each API route / UI page belongs to one.
enum ModuleKey {
  CORE
  ATTENDANCE
  FEES
  EXAMS

  @@map("module_key")
}

enum Role {
  OWNER
  ADMIN
  TEACHER
  ACCOUNTANT
  STAFF
  GUARDIAN
  STUDENT

  @@map("role")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
  /// Added by staff; no access until the person accepts (expires after 14 days).
  INVITED
  /// The person declined the invitation.
  DECLINED

  @@map("membership_status")
}

/// Applied to the percentage before the grade band lookup.
enum RoundingMode {
  NONE
  ROUND_HALF_UP
  CEIL

  @@map("rounding_mode")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum Religion {
  ISLAM
  HINDUISM
  CHRISTIANITY
  BUDDHISM
  OTHER

  @@map("religion")
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE

  @@map("blood_group")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  DROPPED_OUT

  @@map("student_status")
}

enum GuardianRelation {
  FATHER
  MOTHER
  BROTHER
  SISTER
  GRANDFATHER
  GRANDMOTHER
  UNCLE
  AUNT
  OTHER

  @@map("guardian_relation")
}

enum SessionClient {
  WEB
  MOBILE

  @@map("session_client")
}

enum SessionRevokeReason {
  LOGOUT
  REUSE_DETECTED
  ADMIN

  @@map("session_revoke_reason")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE

  @@map("audit_action")
}

/// DAILY: one register per section per day. PER_SESSION: one per class period / batch meeting.
enum AttendanceMode {
  DAILY
  PER_SESSION

  @@map("attendance_mode")
}

/// The institute themes (packages/shared/src/themes.ts holds their colours).
enum ThemePreset {
  SCHOOL
  MADRASA
  COACHING
  ENGLISH_MEDIUM

  @@map("theme_preset")
}

/// A person's light / dark choice; SYSTEM follows the device (the default for everyone).
enum ColorScheme {
  LIGHT
  DARK
  SYSTEM

  @@map("color_scheme")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE

  @@map("attendance_status")
}

/// Why a tenant SMS was sent (billing reports group by this).
enum SmsPurpose {
  ATTENDANCE_ABSENT

  @@map("sms_purpose")
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
  /// Not sent: the reason went away before sending (e.g. absence corrected).
  CANCELLED
  /// Not sent: the tenant's daily SMS cap was reached.
  HELD_OVER_LIMIT
  /// Not sent: held over the cap and not released by an admin before the day ended.
  EXPIRED

  @@map("sms_status")
}

/// SMS sent before any tenant is known (login OTP); platform cost.
enum PlatformSmsPurpose {
  OTP

  @@map("platform_sms_purpose")
}

enum PlatformSmsStatus {
  SENT
  FAILED

  @@map("platform_sms_status")
}

// ───────────────────── Global: institute types & templates ─────────────────────

/// Kind of institute chosen at signup. `key` is data (not an enum) so new types are just rows.
model InstituteType {
  id                             String         @id @default(uuid(7)) @db.Uuid
  key                            String         @unique
  nameBn                         String         @map("name_bn")
  nameEn                         String         @map("name_en")
  defaultLocale                  Locale         @default(bn) @map("default_locale")
  /// Copied into attendance_settings.mode when a tenant is provisioned.
  attendanceMode                 AttendanceMode @default(DAILY) @map("attendance_mode")
  /// The theme an institute of this type gets until its owner picks another.
  defaultTheme                   ThemePreset    @default(SCHOOL) @map("default_theme")
  isActive                       Boolean        @default(true) @map("is_active")
  sortOrder                      Int            @default(0) @map("sort_order")
  defaultGradingSchemeTemplateId String?        @map("default_grading_scheme_template_id") @db.Uuid
  createdAt                      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  defaultGradingSchemeTemplate GradingSchemeTemplate? @relation(fields: [defaultGradingSchemeTemplateId], references: [id], onDelete: SetNull)
  classLevels                  TemplateClassLevel[]
  studyGroups                  TemplateStudyGroup[]
  labels                       TemplateLabel[]
  tenants                      Tenant[]

  @@map("institute_types")
}

model GradingSchemeTemplate {
  id           String       @id @default(uuid(7)) @db.Uuid
  key          String       @unique
  nameBn       String       @map("name_bn")
  nameEn       String       @map("name_en")
  roundingMode RoundingMode @default(NONE) @map("rounding_mode")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  bands          GradeBandTemplate[]
  instituteTypes InstituteType[]
  copies         GradingScheme[]

  @@map("grading_scheme_templates")
}

model GradeBandTemplate {
  id                      String   @id @default(uuid(7)) @db.Uuid
  gradingSchemeTemplateId String   @map("grading_scheme_template_id") @db.Uuid
  /// Inclusive lower bound. A percentage gets the band with the highest min_percent <= it.
  minPercent              Decimal  @map("min_percent") @db.Decimal(5, 2)
  /// Informational upper bound shown to users (e.g. 70–79).
  maxPercent              Decimal  @map("max_percent") @db.Decimal(5, 2)
  letter                  String
  gradePoint              Decimal  @map("grade_point") @db.Decimal(3, 2)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  gradingSchemeTemplate GradingSchemeTemplate @relation(fields: [gradingSchemeTemplateId], references: [id], onDelete: Cascade)

  @@unique([gradingSchemeTemplateId, minPercent])
  @@unique([gradingSchemeTemplateId, letter])
  @@map("grade_band_templates")
}

model TemplateClassLevel {
  id              String   @id @default(uuid(7)) @db.Uuid
  instituteTypeId String   @map("institute_type_id") @db.Uuid
  code            String
  nameBn          String   @map("name_bn")
  nameEn          String   @map("name_en")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  instituteType InstituteType     @relation(fields: [instituteTypeId], references: [id], onDelete: Cascade)
  subjects      TemplateSubject[]
  copies        ClassLevel[]

  @@unique([instituteTypeId, code])
  @@map("template_class_levels")
}

/// e.g. Science / Business Studies / Humanities for NCTB classes 9–10.
model TemplateStudyGroup {
  id              String   @id @default(uuid(7)) @db.Uuid
  instituteTypeId String   @map("institute_type_id") @db.Uuid
  code            String
  nameBn          String   @map("name_bn")
  nameEn          String   @map("name_en")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  instituteType InstituteType     @relation(fields: [instituteTypeId], references: [id], onDelete: Cascade)
  subjects      TemplateSubject[]
  copies        StudyGroup[]

  @@unique([instituteTypeId, code])
  @@map("template_study_groups")
}

model TemplateSubject {
  id                   String   @id @default(uuid(7)) @db.Uuid
  templateClassLevelId String   @map("template_class_level_id") @db.Uuid
  templateStudyGroupId String?  @map("template_study_group_id") @db.Uuid
  code                 String
  nameBn               String   @map("name_bn")
  nameEn               String   @map("name_en")
  isOptional           Boolean  @default(false) @map("is_optional")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  templateClassLevel TemplateClassLevel  @relation(fields: [templateClassLevelId], references: [id], onDelete: Cascade)
  templateStudyGroup TemplateStudyGroup? @relation(fields: [templateStudyGroupId], references: [id], onDelete: SetNull)
  copies             Subject[]

  @@unique([templateClassLevelId, code])
  @@map("template_subjects")
}

/// UI labels that differ by institute type, e.g. key `section` → "Batch" (coaching) / "Section" (school).
model TemplateLabel {
  id              String   @id @default(uuid(7)) @db.Uuid
  instituteTypeId String   @map("institute_type_id") @db.Uuid
  key             String
  valueBn         String   @map("value_bn")
  valueEn         String   @map("value_en")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  instituteType InstituteType @relation(fields: [instituteTypeId], references: [id], onDelete: Cascade)

  @@unique([instituteTypeId, key])
  @@map("template_labels")
}

// ───────────────────────────── Global: people ─────────────────────────────

/// A person, global across tenants. Their roles per tenant are memberships.
model User {
  id           String      @id @default(uuid(7)) @db.Uuid
  /// E.164 Bangladeshi mobile, e.g. +8801712345678 (CHECK constraint in SQL).
  phone        String      @unique
  email        String?     @unique
  name         String
  /// Name in Bangla script, shown in the Bangla UI; falls back to `name`.
  nameBn       String?     @map("name_bn")
  passwordHash String?     @map("password_hash")
  locale       Locale      @default(bn)
  colorScheme  ColorScheme @default(SYSTEM) @map("color_scheme")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  students    Student[]
  guardians   Guardian[]
  auditLogs   AuditLog[]
  sessions    Session[]

  sectionTeachers           SectionTeacher[]
  attendanceSessionsTaken   AttendanceSession[] @relation("AttendanceTakenBy")
  attendanceSessionsUpdated AttendanceSession[] @relation("AttendanceUpdatedBy")
  holidaysCreated           Holiday[]
  studentImports            StudentImport[]
  staffProfiles             StaffProfile[]

  feeConcessionsCreated    FeeConcession[]    @relation("FeeConcessionCreatedBy")
  feeConcessionsEnded      FeeConcession[]    @relation("FeeConcessionEndedBy")
  feeSiblingGroupsCreated  FeeSiblingGroup[]  @relation("FeeSiblingGroupCreatedBy")
  feeSiblingMembersAdded   FeeSiblingMember[] @relation("FeeSiblingMemberAddedBy")
  feeSiblingMembersRemoved FeeSiblingMember[] @relation("FeeSiblingMemberRemovedBy")

  @@map("users")
}

// ───────────────────────────── Tenancy ─────────────────────────────

/// An institute. RLS: a tenant can only see its own row (policy on `id`).
model Tenant {
  id              String        @id @default(uuid(7)) @db.Uuid
  slug            String        @unique
  name            String
  instituteTypeId String        @map("institute_type_id") @db.Uuid
  status          TenantStatus  @default(TRIAL)
  timezone        String        @default("Asia/Dhaka")
  defaultLocale   Locale        @default(bn) @map("default_locale")
  /// While SUSPENDED: the status to return to on reactivation (TRIAL or ACTIVE). Platform only.
  suspendedFrom   TenantStatus? @map("suspended_from")
  suspendedAt     DateTime?     @map("suspended_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  instituteType    InstituteType     @relation(fields: [instituteTypeId], references: [id], onDelete: Restrict)
  modules          TenantModule[]
  labels           TenantLabel[]
  branches         Branch[]
  academicYears    AcademicYear[]
  shifts           Shift[]
  gradingSchemes   GradingScheme[]
  gradeBands       GradeBand[]
  classLevels      ClassLevel[]
  studyGroups      StudyGroup[]
  subjects         Subject[]
  sections         Section[]
  memberships      Membership[]
  students         Student[]
  guardians        Guardian[]
  studentGuardians StudentGuardian[]
  enrolments       Enrolment[]
  auditLogs        AuditLog[]
  sessions         Session[]

  attendanceSettings  AttendanceSettings?
  holidays            Holiday[]
  studentSettings     StudentSettings?
  appearanceSettings  AppearanceSettings?
  studentCodeCounters StudentCodeCounter[]
  sectionTeachers     SectionTeacher[]
  attendanceSessions  AttendanceSession[]
  attendanceRecords   AttendanceRecord[]
  smsLogs             SmsLog[]
  studentImports      StudentImport[]
  staffProfiles       StaffProfile[]
  subscription        TenantSubscription?
  onboarding          OnboardingProgress?
  invoices            PlatformInvoice[]
  invoiceLines        PlatformInvoiceLine[]
  payments            PlatformPayment[]

  feeSettings       FeeSettings?
  feeHeads          FeeHead[]
  feeTerms          FeeTerm[]
  feeAmounts        FeeAmount[]
  feeConcessions    FeeConcession[]
  feeSiblingGroups  FeeSiblingGroup[]
  feeSiblingMembers FeeSiblingMember[]

  @@index([instituteTypeId])
  @@map("tenants")
}

model TenantModule {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  moduleKey ModuleKey @map("module_key")
  enabled   Boolean   @default(true)
  enabledAt DateTime? @map("enabled_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, moduleKey])
  @@map("tenant_modules")
}

/// Tenant's own copy of the template labels; editable per tenant.
model TenantLabel {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  valueBn   String   @map("value_bn")
  valueEn   String   @map("value_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@map("tenant_labels")
}

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String?
  address   String?
  phone     String?
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sections Section[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId], map: "branches_one_main_per_tenant", where: raw("is_main"))
  @@map("branches")
}

model AcademicYear {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sections   Section[]
  enrolments Enrolment[]

  feeTerms       FeeTerm[]
  feeAmounts     FeeAmount[]
  feeConcessions FeeConcession[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@unique([tenantId], map: "academic_years_one_current_per_tenant", where: raw("is_current"))
  @@map("academic_years")
}

/// School shifts (Morning / Day). Times are local wall-clock times in the tenant's timezone.
model Shift {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nameBn    String   @map("name_bn")
  nameEn    String   @map("name_en")
  startTime DateTime @map("start_time") @db.Time(0)
  endTime   DateTime @map("end_time") @db.Time(0)
  sortOrder Int      @default(0) @map("sort_order")
  /// Deactivated instead of deleted once in use; hidden from pickers for new records.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sections Section[]

  @@unique([tenantId, id])
  @@unique([tenantId, nameEn])
  @@map("shifts")
}

// ───────────────────────────── Academic structure ─────────────────────────────

model GradingScheme {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  nameBn           String       @map("name_bn")
  nameEn           String       @map("name_en")
  roundingMode     RoundingMode @default(NONE) @map("rounding_mode")
  isDefault        Boolean      @default(false) @map("is_default")
  sourceTemplateId String?      @map("source_template_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceTemplate GradingSchemeTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  bands          GradeBand[]
  classLevels    ClassLevel[]

  @@unique([tenantId, id])
  @@unique([tenantId], map: "grading_schemes_one_default_per_tenant", where: raw("is_default"))
  @@map("grading_schemes")
}

model GradeBand {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  gradingSchemeId String   @map("grading_scheme_id") @db.Uuid
  /// Inclusive lower bound. A percentage gets the band with the highest min_percent <= it.
  minPercent      Decimal  @map("min_percent") @db.Decimal(5, 2)
  /// Informational upper bound shown to users (e.g. 70–79).
  maxPercent      Decimal  @map("max_percent") @db.Decimal(5, 2)
  letter          String
  gradePoint      Decimal  @map("grade_point") @db.Decimal(3, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  gradingScheme GradingScheme @relation(fields: [tenantId, gradingSchemeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, gradingSchemeId, minPercent])
  @@unique([tenantId, gradingSchemeId, letter])
  @@map("grade_bands")
}

model ClassLevel {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  code             String
  nameBn           String   @map("name_bn")
  nameEn           String   @map("name_en")
  sortOrder        Int      @default(0) @map("sort_order")
  /// Overrides the tenant's default grading scheme for this class level.
  gradingSchemeId  String?  @map("grading_scheme_id") @db.Uuid
  sourceTemplateId String?  @map("source_template_id") @db.Uuid
  /// Deactivated instead of deleted once in use; hidden from pickers for new records.
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  gradingScheme  GradingScheme?      @relation(fields: [tenantId, gradingSchemeId], references: [tenantId, id], onDelete: Restrict)
  sourceTemplate TemplateClassLevel? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  subjects       Subject[]
  sections       Section[]
  enrolments     Enrolment[]
  feeAmounts     FeeAmount[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("class_levels")
}

model StudyGroup {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  code             String
  nameBn           String   @map("name_bn")
  nameEn           String   @map("name_en")
  sortOrder        Int      @default(0) @map("sort_order")
  sourceTemplateId String?  @map("source_template_id") @db.Uuid
  /// Deactivated instead of deleted once in use; hidden from pickers for new records.
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceTemplate TemplateStudyGroup? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  subjects       Subject[]
  enrolments     Enrolment[]
  feeAmounts     FeeAmount[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("study_groups")
}

model Subject {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  classLevelId     String   @map("class_level_id") @db.Uuid
  studyGroupId     String?  @map("study_group_id") @db.Uuid
  code             String
  nameBn           String   @map("name_bn")
  nameEn           String   @map("name_en")
  isOptional       Boolean  @default(false) @map("is_optional")
  sortOrder        Int      @default(0) @map("sort_order")
  sourceTemplateId String?  @map("source_template_id") @db.Uuid
  /// Deactivated instead of deleted once in use; hidden from pickers for new records.
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  classLevel     ClassLevel       @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict)
  studyGroup     StudyGroup?      @relation(fields: [tenantId, studyGroupId], references: [tenantId, id], onDelete: Restrict)
  sourceTemplate TemplateSubject? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  attendanceSessions AttendanceSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, classLevelId, code])
  @@map("subjects")
}

/// A section (school) or batch (coaching) of a class level in one academic year.
model Section {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classLevelId   String   @map("class_level_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  shiftId        String?  @map("shift_id") @db.Uuid
  name           String
  capacity       Int?
  sortOrder      Int      @default(0) @map("sort_order")
  /// Deactivated instead of deleted once in use; hidden from pickers for new records.
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  classLevel   ClassLevel   @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  shift        Shift?       @relation(fields: [tenantId, shiftId], references: [tenantId, id], onDelete: Restrict)
  enrolments   Enrolment[]

  teachers           SectionTeacher[]
  attendanceSessions AttendanceSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, classLevelId, name])
  @@index([tenantId, classLevelId])
  @@map("sections")
}

// ───────────────────────────── People in a tenant ─────────────────────────────

model Membership {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      Role
  status    MembershipStatus @default(ACTIVE)
  /// When the (latest) invitation was sent; INVITED rows older than 14 days have expired.
  invitedAt DateTime?        @map("invited_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId, role])
  @@index([tenantId, role])
  @@index([userId])
  @@map("memberships")
}

model Student {
  id                  String        @id @default(uuid(7)) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  studentCode         String        @map("student_code")
  userId              String?       @map("user_id") @db.Uuid
  nameBn              String?       @map("name_bn")
  nameEn              String?       @map("name_en")
  dateOfBirth         DateTime?     @map("date_of_birth") @db.Date
  gender              Gender?
  photoUrl            String?       @map("photo_url")
  status              StudentStatus @default(ACTIVE)
  // Fields required for Bangladesh education board registration.
  fatherNameBn        String?       @map("father_name_bn")
  fatherNameEn        String?       @map("father_name_en")
  motherNameBn        String?       @map("mother_name_bn")
  motherNameEn        String?       @map("mother_name_en")
  religion            Religion?
  /// 17-digit birth registration number; unique per tenant when present.
  birthRegistrationNo String?       @map("birth_registration_no")
  bloodGroup          BloodGroup?   @map("blood_group")
  presentAddress      String?       @map("present_address")
  permanentAddress    String?       @map("permanent_address")
  /// Soft delete. Queries must filter `deletedAt: null` themselves.
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians  StudentGuardian[]
  enrolments Enrolment[]

  attendanceRecords AttendanceRecord[]
  feeConcessions    FeeConcession[]
  feeSiblingMembers FeeSiblingMember[]

  @@unique([tenantId, id])
  @@unique([tenantId, studentCode])
  @@unique([tenantId, birthRegistrationNo])
  @@index([tenantId, status], where: raw("deleted_at IS NULL"))
  @@index([tenantId, nameEn])
  // Trigram indexes for ILIKE '%…%' search (GET /students).
  @@index([nameBn(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_name_bn_trgm_idx")
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_name_en_trgm_idx")
  @@index([studentCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_student_code_trgm_idx")
  @@map("students")
}

model Guardian {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Set when the guardian logs in to the app (phone OTP).
  userId     String?  @map("user_id") @db.Uuid
  nameBn     String?  @map("name_bn")
  nameEn     String?  @map("name_en")
  /// E.164 Bangladeshi mobile; used for SMS notifications.
  phone      String
  email      String?
  occupation String?
  address    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]

  @@unique([tenantId, id])
  @@index([tenantId, phone])
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "guardians_phone_trgm_idx")
  @@map("guardians")
}

model StudentGuardian {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  guardianId String           @map("guardian_id") @db.Uuid
  relation   GuardianRelation
  isPrimary  Boolean          @default(false) @map("is_primary")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student  Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  guardian Guardian @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, studentId, guardianId])
  @@unique([tenantId, studentId], map: "student_guardians_one_primary_per_student", where: raw("is_primary"))
  @@index([tenantId, guardianId])
  @@map("student_guardians")
}

model Enrolment {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classLevelId   String   @map("class_level_id") @db.Uuid
  sectionId      String?  @map("section_id") @db.Uuid
  studyGroupId   String?  @map("study_group_id") @db.Uuid
  roll           Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  classLevel   ClassLevel   @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict)
  section      Section?     @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict)
  studyGroup   StudyGroup?  @relation(fields: [tenantId, studyGroupId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, studentId])
  @@unique([tenantId, sectionId, roll])
  @@index([tenantId, academicYearId, classLevelId, sectionId])
  @@index([tenantId, studentId])
  @@map("enrolments")
}

/// The institute's theme, one row per tenant once the owner saves it; until then the institute
/// type's default theme and the preset's own accent (no backfill).
model AppearanceSettings {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @unique @map("tenant_id") @db.Uuid
  /// Null: the institute type's default (institute_types.default_theme).
  preset    ThemePreset?
  /// "#rrggbb" in lower case; null: the preset's own accent. The API checks its contrast.
  accent    String?      @db.Char(7)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("appearance_settings")
}

/// One row per tenant once an admin saves it; defaults live in code until then (no backfill).
model StudentSettings {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @unique @map("tenant_id") @db.Uuid
  /// 1–10 uppercase letters/digits, used by {PREFIX}.
  codePrefix  String   @map("code_prefix")
  /// Tokens: {PREFIX}, {YEAR}, {YY}, and one {N…} run (zero-padded sequence).
  codePattern String   @default("{PREFIX}-{YEAR}-{NNNN}") @map("code_pattern")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("student_settings")
}

/// Next student_code sequence number per tenant and year (atomic upsert ... RETURNING).
model StudentCodeCounter {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  year      Int
  nextValue Int      @map("next_value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, year])
  @@map("student_code_counters")
}

enum StudentImportStatus {
  UPLOADED
  VALIDATED
  QUEUED
  RUNNING
  DONE
  FAILED

  @@map("student_import_status")
}

/// One Excel/CSV student import. The raw rows (phones, birth registration numbers) are cleared
/// when it finishes or after 7 days unfinished; results keep row numbers, statuses and messages.
/// History: never deleted by the app.
model StudentImport {
  id                 String              @id @default(uuid(7)) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  /// Plain FK: users are global. The service checks the uploader is OWNER/ADMIN here.
  createdById        String              @map("created_by_id") @db.Uuid
  status             StudentImportStatus @default(UPLOADED)
  fileName           String              @map("file_name")
  headers            Json                @db.JsonB
  /// string[][] data rows; NULL once cleared.
  rows               Json?               @db.JsonB
  mapping            Json?               @db.JsonB
  /// ImportRowResult[] (preview, then the outcome; kept as history, incl. who a possible duplicate looked like).
  results            Json?               @db.JsonB
  /// Rows flagged "possible duplicate" that the admin chose to import anyway (decision #22).
  duplicateOverrides Int[]               @default([]) @map("duplicate_overrides")
  rowCount           Int                 @map("row_count")
  processed          Int                 @default(0)
  failure            String?
  finishedAt         DateTime?           @map("finished_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("student_imports")
}

/// How this institute knows a staff member: the name and phone its admin typed. Shown instead
/// of the person's global name (which another institute, or the person, may have set).
model StaffProfile {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Plain FK: users are global. The service only creates profiles with a staff membership.
  userId    String   @map("user_id") @db.Uuid
  name      String
  nameBn    String?  @map("name_bn")
  /// E.164, as typed (the person's own row is invisible to the institute while invited).
  phone     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("staff_profiles")
}

// ───────────────────────────── Audit ─────────────────────────────

/// Append-only: the app role may only SELECT and INSERT.
model AuditLog {
  id          String      @id @default(uuid(7)) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  entity      String
  entityId    String      @map("entity_id") @db.Uuid
  action      AuditAction
  oldValues   Json?       @map("old_values") @db.JsonB
  newValues   Json?       @map("new_values") @db.JsonB
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUser User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ───────────────────────────── Attendance ─────────────────────────────
// Module ATTENDANCE. Dates are calendar dates in the tenant's timezone (tenants.timezone).

/// One row per tenant, created by provisionTenant() from the institute type's defaults.
model AttendanceSettings {
  id                    String         @id @default(uuid(7)) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  mode                  AttendanceMode @default(DAILY)
  /// ISO weekdays (1 = Monday … 7 = Sunday) with no attendance. Default: Friday.
  weeklyOffDays         Int[]          @default([5]) @map("weekly_off_days")
  /// How many days back a teacher may still take or change attendance (0 = same day only).
  editWindowDays        Int            @default(0) @map("edit_window_days") @db.SmallInt
  /// Present % normally leaves LEAVE out of the total; when true, LEAVE counts as absent.
  leaveCountsAsAbsent   Boolean        @default(false) @map("leave_counts_as_absent")
  absentSmsEnabled      Boolean        @default(false) @map("absent_sms_enabled")
  /// Variables: {student}, {date}, {institute}. Null = the built-in default template.
  absentSmsTemplate     String?        @map("absent_sms_template")
  /// Wait before sending, so a mis-tap corrected right away never reaches a guardian.
  absentSmsDelayMinutes Int            @default(10) @map("absent_sms_delay_minutes") @db.SmallInt
  /// Max SMS per day (tenant timezone). Null = 2 × active students.
  dailySmsCap           Int?           @map("daily_sms_cap")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId])
  @@unique([tenantId, id])
  @@map("attendance_settings")
}

/// No attendance on these dates unless an admin overrides.
model Holiday {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  nameBn      String   @map("name_bn")
  nameEn      String   @map("name_en")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, startDate])
  @@map("holidays")
}

/// Teachers who may take attendance for a section (sections belong to one academic year).
model SectionTeacher {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  isClassTeacher Boolean  @default(false) @map("is_class_teacher")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  section Section @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, sectionId, userId])
  @@unique([tenantId, sectionId], map: "section_teachers_one_class_teacher", where: raw("is_class_teacher"))
  @@index([tenantId, userId])
  @@map("section_teachers")
}

/// One register: a section on a date, for the whole day (period_no 0) or one period.
model AttendanceSession {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  sectionId        String   @map("section_id") @db.Uuid
  date             DateTime @db.Date
  /// 0 = the whole day (DAILY mode); 1.. = a period (PER_SESSION mode).
  periodNo         Int      @default(0) @map("period_no") @db.SmallInt
  subjectId        String?  @map("subject_id") @db.Uuid
  takenById        String   @map("taken_by_id") @db.Uuid
  updatedById      String   @map("updated_by_id") @db.Uuid
  submittedAt      DateTime @map("submitted_at") @db.Timestamptz(3)
  /// Optimistic concurrency: a submit must name the version it was based on.
  version          Int      @default(1)
  /// The client's id for the last accepted submit, so a retried request is answered, not re-applied.
  lastSubmissionId String   @map("last_submission_id") @db.Uuid
  /// Taken on a weekly off day or holiday (admin override).
  onNonWorkingDay  Boolean  @default(false) @map("on_non_working_day")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  section   Section            @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Restrict)
  subject   Subject?           @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  takenBy   User               @relation("AttendanceTakenBy", fields: [takenById], references: [id], onDelete: Restrict)
  updatedBy User               @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  records   AttendanceRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, sectionId, date, periodNo])
  @@index([tenantId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session AttendanceSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)
  student Student           @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, studentId])
  @@index([tenantId, studentId])
  @@map("attendance_records")
}

// ───────────────────────────── SMS logs ─────────────────────────────

/// Every SMS sent for a tenant (we bill from this). Bodies of tenant SMS never contain secrets.
model SmsLog {
  id                String     @id @default(uuid(7)) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  phone             String
  purpose           SmsPurpose
  status            SmsStatus  @default(QUEUED)
  segments          Int        @db.SmallInt
  body              String
  /// The tenant-local day it belongs to (daily cap, billing).
  localDate         DateTime   @map("local_date") @db.Date
  /// At most one SMS per key per tenant, e.g. "absent:<student_id>:<date>".
  dedupeKey         String?    @map("dedupe_key")
  relatedEntity     String?    @map("related_entity")
  relatedId         String?    @map("related_id") @db.Uuid
  sendAfter         DateTime?  @map("send_after") @db.Timestamptz(3)
  sentAt            DateTime?  @map("sent_at") @db.Timestamptz(3)
  /// Set when sent: segments × the platform's rate then (a later rate change keeps past costs).
  costPaisa         Int?       @map("cost_paisa")
  providerMessageId String?    @map("provider_message_id")
  error             String?
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, dedupeKey], map: "sms_logs_dedupe", where: raw("dedupe_key IS NOT NULL"))
  @@index([tenantId, localDate])
  @@index([tenantId, createdAt(sort: Desc)])
  /// Platform usage: a month's sent SMS across institutes.
  @@index([localDate], map: "sms_logs_sent_local_date", where: raw("status = 'SENT'"))
  @@map("sms_logs")
}

/// Global: SMS sent before any tenant is known (login OTP). The app role may only INSERT, never
/// read: it holds phone numbers of every user. The body (it contains the OTP) is never stored.
model PlatformSmsLog {
  id                String             @id @default(uuid(7)) @db.Uuid
  phone             String
  purpose           PlatformSmsPurpose
  status            PlatformSmsStatus
  segments          Int                @db.SmallInt
  /// SENT rows: segments × the platform's rate when sent.
  costPaisa         Int?               @map("cost_paisa")
  providerMessageId String?            @map("provider_message_id")
  error             String?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("platform_sms_logs")
}

// ───────────────────────────── Auth sessions ─────────────────────────────
// User-owned (not tenant-owned): RLS on user_id = app_current_user_id(). See docs/auth.md.

/// One login on one device ("logged-in devices"). Refresh tokens rotate inside it.
model Session {
  id             String               @id @default(uuid(7)) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  /// Tenant selected via switch-tenant; refresh re-issues access tokens for it.
  activeTenantId String?              @map("active_tenant_id") @db.Uuid
  client         SessionClient
  userAgent      String?              @map("user_agent")
  ip             String?
  lastUsedAt     DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// Sliding: renewed on every refresh.
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokeReason   SessionRevokeReason? @map("revoke_reason")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant  Tenant?        @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@unique([userId, id])
  @@index([userId])
  @@map("sessions")
}

/// Rotation chain of a session. Only the SHA-256 of each token is stored.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when this token was exchanged for a new one. Presenting it again is reuse
  /// (except the 30 s idempotent-retry window, see docs/auth.md).
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  session Session @relation(fields: [userId, sessionId], references: [userId, id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────── Platform (Jantrik's own staff) ───────────────────────────
// Global tables, not tenant data. jantrik_app has no grants on them: the API reaches them only
// through SECURITY DEFINER functions owned by jantrik_platform (see docs/platform.md).

enum PlatformSessionRevokeReason {
  LOGOUT
  DISABLED
  RESET_2FA

  @@map("platform_session_revoke_reason")
}

enum PlatformActor {
  ADMIN
  CLI

  @@map("platform_actor")
}

/// A Jantrik staff member who runs the platform. Never a `users` row.
model PlatformAdmin {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  /// E.164 (+8801…).
  phone         String    @unique
  email         String?   @unique
  passwordHash  String    @map("password_hash")
  /// TOTP secret, AES-256-GCM encrypted with PLATFORM_TOTP_KEY; NULL until enrolled.
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Until when the authenticator may be set up (first login, or after reset-2fa); NULL: closed.
  totpEnrolBy   DateTime? @map("totp_enrol_by") @db.Timestamptz(3)
  /// Last accepted 30 s time step (a code is never accepted twice).
  totpLastStep  BigInt?   @map("totp_last_step")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  backupCodes   PlatformAdminBackupCode[]
  sessions      PlatformSession[]
  auditLogs     PlatformAuditLog[]
  payments      PlatformPayment[]
  settingsEdits PlatformSettings[]

  @@map("platform_admins")
}

/// One-time 2FA backup codes (HMAC hashes, never the codes).
model PlatformAdminBackupCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, codeHash])
  @@map("platform_admin_backup_codes")
}

/// A signed-in platform admin: an opaque cookie token (only its hash here). Short: idle and
/// absolute expiry, checked on every request.
model PlatformSession {
  id            String                       @id @default(uuid(7)) @db.Uuid
  adminId       String                       @map("admin_id") @db.Uuid
  tokenHash     String                       @unique @map("token_hash") @db.Char(64)
  ip            String?
  userAgent     String?                      @map("user_agent")
  lastUsedAt    DateTime                     @default(now()) @map("last_used_at") @db.Timestamptz(3)
  idleExpiresAt DateTime                     @map("idle_expires_at") @db.Timestamptz(3)
  expiresAt     DateTime                     @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  revokeReason  PlatformSessionRevokeReason? @map("revoke_reason")
  createdAt     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_sessions")
}

/// Everything platform admins (and the CLI) do. Append-only.
model PlatformAuditLog {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// NULL for CLI actions.
  adminId        String?       @map("admin_id") @db.Uuid
  actor          PlatformActor
  action         String
  /// The institute acted on, if any (not `tenant_id`: this is not a tenant table).
  targetTenantId String?       @map("target_tenant_id") @db.Uuid
  entity         String?
  entityId       String?       @map("entity_id")
  details        Json?         @db.JsonB
  ip             String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([targetTenantId, createdAt(sort: Desc)])
  @@map("platform_audit_logs")
}

/// How a plan charges: per active student per month for each enabled module, or a flat price.
enum PlanPricing {
  PER_STUDENT
  FLAT

  @@map("plan_pricing")
}

enum BillingCycle {
  MONTHLY
  YEARLY

  @@map("billing_cycle")
}

/// Jantrik's plan and limits for one institute. The institute may read its own row (the limits are
/// enforced in its requests); only the platform functions (jantrik_platform) write it. Institutes
/// created before step 8 have none: no plan, no limits. Amounts in paisa.
model TenantSubscription {
  id                    String       @id @default(uuid(7)) @db.Uuid
  tenantId              String       @unique @map("tenant_id") @db.Uuid
  /// NULL: no plan yet (nothing is invoiced).
  planName              String?      @map("plan_name")
  pricing               PlanPricing  @default(PER_STUDENT)
  /// PER_STUDENT: paisa per active student per month, per enabled module (CORE is always on).
  corePaisa             Int          @default(0) @map("core_paisa")
  attendancePaisa       Int          @default(0) @map("attendance_paisa")
  feesPaisa             Int          @default(0) @map("fees_paisa")
  examsPaisa            Int          @default(0) @map("exams_paisa")
  /// FLAT: paisa per month.
  flatPaisa             Int          @default(0) @map("flat_paisa")
  cycle                 BillingCycle @default(MONTHLY)
  /// YEARLY: 12 × monthly minus this percentage.
  yearlyDiscountPercent Int          @default(0) @map("yearly_discount_percent") @db.SmallInt
  /// Invoices are due this many days after they are issued.
  dueDays               Int          @default(10) @map("due_days") @db.SmallInt
  trialEndsOn           DateTime?    @map("trial_ends_on") @db.Date
  /// Admissions and imports stop once active students reach it. NULL: no limit.
  studentLimit          Int?         @map("student_limit")
  /// A ceiling on the institute's daily SMS cap (the lower of the two applies). NULL: none.
  smsDailyCap           Int?         @map("sms_daily_cap")
  /// The first month invoiced (its first day). Set on activation (the next month); NULL: not yet.
  billingStartsOn       DateTime?    @map("billing_starts_on") @db.Date
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("tenant_subscriptions")
}

/// The new owner's setup wizard (step 8, part 5): one row per institute the platform creates.
/// Institutes without one (made before the wizard, the demo ones) never see the wizard.
model OnboardingProgress {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @unique @map("tenant_id") @db.Uuid
  /// Step key (year, classes, shifts, teachers, students, attendance) to 'done' or 'skipped'.
  /// A missing key: not answered yet.
  steps       Json      @default("{}") @db.JsonB
  /// Set when the wizard is finished; the dashboard then stops offering it.
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("onboarding_progress")
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID

  @@map("invoice_status")
}

/// A line of a platform invoice: a module (per active student), the flat price, or the yearly
/// discount (a negative amount).
enum InvoiceLineKind {
  CORE
  ATTENDANCE
  FEES
  EXAMS
  FLAT
  DISCOUNT

  @@map("invoice_line_kind")
}

enum PaymentMethod {
  CASH
  BKASH
  BANK

  @@map("payment_method")
}

/// Jantrik's invoice to an institute for one period (a month, or 12 months on a yearly plan).
/// The institute may read its own; only the platform functions write. Overdue = ISSUED and past
/// due_on (computed, not stored). History: no DELETE for anyone.
model PlatformInvoice {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  cycle       BillingCycle
  issuedOn    DateTime      @map("issued_on") @db.Date
  dueOn       DateTime      @map("due_on") @db.Date
  status      InvoiceStatus @default(ISSUED)
  totalPaisa  Int           @map("total_paisa")
  paidPaisa   Int           @default(0) @map("paid_paisa")
  voidReason  String?       @map("void_reason")
  voidedAt    DateTime?     @map("voided_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lines    PlatformInvoiceLine[]
  payments PlatformPayment[]

  @@unique([tenantId, id])
  /// One live invoice per institute and period (a voided one can be issued again).
  @@unique([tenantId, periodStart], map: "platform_invoices_tenant_period", where: raw("status <> 'VOID'"))
  @@index([tenantId, dueOn])
  @@map("platform_invoices")
}

model PlatformInvoiceLine {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  invoiceId      String          @map("invoice_id") @db.Uuid
  kind           InvoiceLineKind
  /// Per-student lines: the active students counted when the invoice was made.
  activeStudents Int?            @map("active_students")
  unitPaisa      Int             @map("unit_paisa")
  months         Int             @db.SmallInt
  amountPaisa    Int             @map("amount_paisa")
  sortOrder      Int             @default(0) @map("sort_order") @db.SmallInt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice PlatformInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@map("platform_invoice_lines")
}

/// A payment recorded by a platform admin (cash, bKash or bank). Append-only.
model PlatformPayment {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  amountPaisa  Int           @map("amount_paisa")
  method       PaymentMethod
  reference    String?
  paidOn       DateTime      @map("paid_on") @db.Date
  recordedById String        @map("recorded_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice    PlatformInvoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  recordedBy PlatformAdmin   @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@map("platform_payments")
}

/// Platform-wide settings: one row (id 1). Global on purpose (Jantrik's own costs, not an
/// institute's): no tenant_id, no RLS. The app reads only the SMS rate; only the platform
/// functions change it (audited).
model PlatformSettings {
  id                     Int      @id @default(1) @db.SmallInt
  /// What one SMS segment costs Jantrik, copied onto every SMS when it is sent.
  smsCostPerSegmentPaisa Int      @default(30) @map("sms_cost_per_segment_paisa")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById            String?  @map("updated_by_id") @db.Uuid

  updatedBy PlatformAdmin? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

// ───────────────────────────── Fees (module FEES, step 9) ─────────────────────────────
// Rules: docs/fees.md. Money is integer paisa; dates are calendar dates in the tenant's timezone.

enum FeeHeadKind {
  ADMISSION
  TUITION
  EXAM
  SESSION
  OTHER

  @@map("fee_head_kind")
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  PER_TERM
  YEARLY

  @@map("fee_frequency")
}

enum FeeFineType {
  NONE
  /// A fixed amount once the due date has passed.
  FLAT
  /// An amount per day after the due date, up to a cap.
  PER_DAY

  @@map("fee_fine_type")
}

/// FIXED: paisa. PERCENT: whole percent 1–100.
enum FeeAmountType {
  FIXED
  PERCENT

  @@map("fee_amount_type")
}

enum FeeConcessionCategory {
  GENERAL
  /// Full free studentship (100 %).
  FREE_FULL
  /// Half free studentship (50 %).
  FREE_HALF
  /// Needs a reason.
  SCHOLARSHIP

  @@map("fee_concession_category")
}

/// One row per tenant once an admin saves it; defaults live in code until then (no backfill).
model FeeSettings {
  id                   String         @id @default(uuid(7)) @db.Uuid
  tenantId             String         @unique @map("tenant_id") @db.Uuid
  /// First day of the first month that gets dues. Null: no dues are generated yet, so switching
  /// fees on mid-year never charges earlier months.
  duesFrom             DateTime?      @map("dues_from") @db.Date
  receiptSmsEnabled    Boolean        @default(true) @map("receipt_sms_enabled")
  /// Discount for the from_child-th and later child of a confirmed family; null = none.
  siblingDiscountType  FeeAmountType? @map("sibling_discount_type")
  siblingDiscountValue Int?           @map("sibling_discount_value")
  siblingFromChild     Int            @default(2) @map("sibling_from_child") @db.SmallInt
  /// A line printed at the foot of every receipt (address, phone, thanks).
  receiptNote          String?        @map("receipt_note")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("fee_settings")
}

/// What is charged (tuition, admission, exam…) and how often. Deactivated, never deleted.
model FeeHead {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  nameBn          String       @map("name_bn")
  nameEn          String       @map("name_en")
  kind            FeeHeadKind
  frequency       FeeFrequency
  /// MONTHLY only: day of the month the fee is due (1–28).
  dueDay          Int?         @map("due_day") @db.SmallInt
  /// YEARLY: days after the year starts; ONE_TIME: days after admission.
  dueOffsetDays   Int          @default(0) @map("due_offset_days") @db.SmallInt
  /// ONE_TIME only: charged to students admitted on or after this date; null = never automatic.
  oneTimeFrom     DateTime?    @map("one_time_from") @db.Date
  fineType        FeeFineType  @default(NONE) @map("fine_type")
  fineAmountPaisa Int          @default(0) @map("fine_amount_paisa")
  /// PER_DAY only: the most a due's fine can reach.
  fineCapPaisa    Int?         @map("fine_cap_paisa")
  /// The sibling discount applies to this head.
  siblingEligible Boolean      @default(false) @map("sibling_eligible")
  isActive        Boolean      @default(true) @map("is_active")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  amounts     FeeAmount[]
  concessions FeeConcession[]

  @@unique([tenantId, id])
  // Unique among active heads only: a deactivated head frees its name.
  @@unique([tenantId, nameBn], map: "fee_heads_active_name", where: raw("is_active"))
  @@index([tenantId, sortOrder])
  @@map("fee_heads")
}

/// A term of an academic year, for PER_TERM heads (opens, then falls due).
model FeeTerm {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  nameBn         String   @map("name_bn")
  nameEn         String   @map("name_en")
  opensOn        DateTime @map("opens_on") @db.Date
  dueDate        DateTime @map("due_date") @db.Date
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, nameBn])
  @@index([tenantId, academicYearId])
  @@map("fee_terms")
}

/// How much a head costs for a class level in a year; a study-group row overrides the class row.
model FeeAmount {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  feeHeadId      String   @map("fee_head_id") @db.Uuid
  classLevelId   String   @map("class_level_id") @db.Uuid
  studyGroupId   String?  @map("study_group_id") @db.Uuid
  amountPaisa    Int      @map("amount_paisa")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  feeHead      FeeHead      @relation(fields: [tenantId, feeHeadId], references: [tenantId, id], onDelete: Restrict)
  classLevel   ClassLevel   @relation(fields: [tenantId, classLevelId], references: [tenantId, id], onDelete: Restrict)
  studyGroup   StudyGroup?  @relation(fields: [tenantId, studyGroupId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, feeHeadId, classLevelId], map: "fee_amounts_class_default", where: raw("study_group_id IS NULL"))
  @@unique([tenantId, academicYearId, feeHeadId, classLevelId, studyGroupId], map: "fee_amounts_group_override", where: raw("study_group_id IS NOT NULL"))
  @@index([tenantId, academicYearId, classLevelId])
  @@map("fee_amounts")
}

/// A student's concession on one head for one year. Ended (ended_on), never deleted.
model FeeConcession {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  studentId      String                @map("student_id") @db.Uuid
  feeHeadId      String                @map("fee_head_id") @db.Uuid
  academicYearId String                @map("academic_year_id") @db.Uuid
  category       FeeConcessionCategory
  type           FeeAmountType
  value          Int
  reason         String?
  /// Applies to dues falling due on or after this date.
  validFrom      DateTime              @map("valid_from") @db.Date
  /// Applies to dues falling due before this date; null = still active.
  endedOn        DateTime?             @map("ended_on") @db.Date
  endedReason    String?               @map("ended_reason")
  createdById    String                @map("created_by_id") @db.Uuid
  endedById      String?               @map("ended_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  feeHead      FeeHead      @relation(fields: [tenantId, feeHeadId], references: [tenantId, id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Restrict)
  createdBy    User         @relation("FeeConcessionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  endedBy      User?        @relation("FeeConcessionEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, studentId, feeHeadId, academicYearId], map: "fee_concessions_one_active", where: raw("ended_on IS NULL"))
  @@index([tenantId, studentId])
  @@map("fee_concessions")
}

/// A family confirmed by an admin (siblings get the sibling discount only once confirmed).
model FeeSiblingGroup {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User               @relation("FeeSiblingGroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members   FeeSiblingMember[]

  @@unique([tenantId, id])
  @@map("fee_sibling_groups")
}

/// A student in a confirmed family. Removed (removed_at), never deleted.
model FeeSiblingMember {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  groupId       String    @map("group_id") @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  addedById     String    @map("added_by_id") @db.Uuid
  removedAt     DateTime? @map("removed_at") @db.Timestamptz(3)
  removedById   String?   @map("removed_by_id") @db.Uuid
  removedReason String?   @map("removed_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  group     FeeSiblingGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Restrict)
  student   Student         @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  addedBy   User            @relation("FeeSiblingMemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  removedBy User?           @relation("FeeSiblingMemberRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, studentId], map: "fee_sibling_members_one_family", where: raw("removed_at IS NULL"))
  @@index([tenantId, groupId])
  @@map("fee_sibling_members")
}
