// Prisma schema for Jantrik School — Phase 1 core.
// Read docs/database.md before adding a table.
//
// Conventions
// - UUIDv7 primary keys, snake_case in the DB (@map / @@map), created_at + updated_at everywhere
//   (audit_logs is append-only and has created_at only).
// - Tenant-owned tables: tenant_id NOT NULL, @@unique([tenantId, id]) and composite foreign keys
//   (tenant_id, x_id) for every reference to another tenant-owned table, so a row can never point
//   at another tenant's data. Row-Level Security is added in SQL migrations.
// - Global tables (institute types, templates, users) have no tenant_id and no RLS; the app role
//   can only read templates.
// - CHECK constraints, RLS policies and grants live in hand-written SQL migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // pg_trgm: trigram GIN indexes for substring search (students, guardians).
  extensions = [pg_trgm]
}

// ───────────────────────────── Enums ─────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("tenant_status")
}

enum Locale {
  bn
  en

  @@map("locale")
}

/// Product modules a tenant can enable. Each API route / UI page belongs to one.
enum ModuleKey {
  CORE
  ATTENDANCE
  FEES
  EXAMS

  @@map("module_key")
}

enum Role {
  OWNER
  ADMIN
  TEACHER
  ACCOUNTANT
  STAFF
  GUARDIAN
  STUDENT

  @@map("role")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
  /// Added by staff; no access until the person accepts (expires after 14 days).
  INVITED
  /// The person declined the invitation.
  DECLINED

  @@map("membership_status")
}

/// Applied to the percentage before the grade band lookup.
enum RoundingMode {
  NONE
  ROUND_HALF_UP
  CEIL

  @@map("rounding_mode")
}

/// How a GPA is cut to the decimals it is shown with.
enum GpaRounding {
  TRUNCATE
  ROUND_HALF_UP

  @@map("gpa_rounding")
}

/// How a subject is passed: each component on its own mark, or components of the same kind summed
/// across papers (Bangla 1st + 2nd paper CQ) against one combined mark.
enum PassRule {
  PER_COMPONENT
  COMBINED

  @@map("pass_rule")
}

/// The kind of an exam part (papers of one subject share kinds: P1_CQ and P2_CQ are both CQ).
enum ComponentKind {
  CQ
  MCQ
  PRACTICAL
  WRITTEN
  ORAL
  OTHER

  @@map("component_kind")
}

/// A student's choice of a subject from the class's elective pool.
enum SubjectChoiceKind {
  COMPULSORY
  /// The 4th subject: only its points above the scheme's threshold count towards the GPA.
  OPTIONAL

  @@map("subject_choice_kind")
}

enum ExamKind {
  HALF_YEARLY
  ANNUAL
  PRE_TEST
  TEST
  CLASS_TEST
  MODEL_TEST
  OTHER

  @@map("exam_kind")
}

/// GPA (NCTB: grades, GPA and the 4th subject) or MARKS (total and percentage only).
enum ExamResultMode {
  GPA
  MARKS

  @@map("exam_result_mode")
}

/// SETUP: only admins see it. OPEN: marks are entered. ARCHIVED: read-only.
enum ExamStatus {
  SETUP
  OPEN
  ARCHIVED

  @@map("exam_status")
}

/// Merit list: failed students after all passed ones, or with no position.
enum MeritFailedRanking {
  AFTER_PASSED
  UNRANKED

  @@map("merit_failed_ranking")
}

enum ExamCandidateStatus {
  ENROLLED
  /// Left the class (or the institute) after the exam opened: marks kept, left out of results.
  WITHDRAWN

  @@map("exam_candidate_status")
}

/// DRAFT (being entered; teachers may edit) → SUBMITTED (complete; still editable until locked)
/// → LOCKED (by an admin; only OWNER/ADMIN corrections, with a reason).
enum MarkSheetStatus {
  DRAFT
  SUBMITTED
  LOCKED

  @@map("mark_sheet_status")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum Religion {
  ISLAM
  HINDUISM
  CHRISTIANITY
  BUDDHISM
  OTHER

  @@map("religion")
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE

  @@map("blood_group")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  DROPPED_OUT

  @@map("student_status")
}

enum GuardianRelation {
  FATHER
  MOTHER
  BROTHER
  SISTER
  GRANDFATHER
  GRANDMOTHER
  UNCLE
  AUNT
  OTHER

  @@map("guardian_relation")
}

enum SessionClient {
  WEB
  MOBILE

  @@map("session_client")
}

enum SessionRevokeReason {
  LOGOUT
  REUSE_DETECTED
  ADMIN
  /// The person set a new password: their other sessions end.
  PASSWORD_CHANGED

  @@map("session_revoke_reason")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE

  @@map("audit_action")
}

/// DAILY: one register per section per day. PER_SESSION: one per class period / batch meeting.
enum AttendanceMode {
  DAILY
  PER_SESSION

  @@map("attendance_mode")
}

/// The institute themes (packages/shared/src/themes.ts holds their colours).
enum ThemePreset {
  SCHOOL
  MADRASA
  COACHING
  ENGLISH_MEDIUM

  @@map("theme_preset")
}

/// A person's light / dark choice; SYSTEM follows the device (the default for everyone).
enum ColorScheme {
  LIGHT
  DARK
  SYSTEM

  @@map("color_scheme")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE

  @@map("attendance_status")
}

/// Who wrote a register, a mark or a staff day: a person (MANUAL) or the device job (DEVICE).
enum AttendanceSource {
  MANUAL
  DEVICE

  @@map("attendance_source")
}

/// Why a tenant SMS was sent (billing reports group by this).
enum SmsPurpose {
  ATTENDANCE_ABSENT
  /// A money receipt to the primary guardian (fees).
  FEE_RECEIPT
  /// A due reminder to the primary guardian (fees).
  FEE_REMINDER
  /// A published exam result to the primary guardian (exams).
  EXAM_RESULT
  /// A student's entry punch, to the primary guardian (devices; at most one a day).
  ATTENDANCE_ENTRY
  /// A student's exit punch, to the primary guardian (devices; at most one a day).
  ATTENDANCE_EXIT
  /// The code that proves an applicant's phone (online admission, sprint 1 P3). Body masked.
  ADMISSION_OTP
  /// "Application received" to the applicant's phone (online admission, S11).
  ADMISSION_SUBMITTED
  ADMISSION_RESULT
  /// An admin's SMS broadcast to guardians or staff (notices, sprint 1 P6b).
  BROADCAST

  @@map("sms_purpose")
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
  /// Not sent: the reason went away before sending (e.g. absence corrected).
  CANCELLED
  /// Not sent: the tenant's daily SMS cap was reached.
  HELD_OVER_LIMIT
  /// Not sent: held over the cap and not released by an admin before the day ended.
  EXPIRED

  @@map("sms_status")
}

/// SMS sent before any tenant is known (login OTP); platform cost.
enum PlatformSmsPurpose {
  OTP

  @@map("platform_sms_purpose")
}

enum PlatformSmsStatus {
  SENT
  FAILED

  @@map("platform_sms_status")
}

// ───────────────────── Global: institute types & templates ─────────────────────

/// Kind of institute chosen at signup. `key` is data (not an enum) so new types are just rows.
model InstituteType {
  id                             String         @id @default(uuid(7)) @db.Uuid
  key                            String         @unique
  nameBn                         String         @map("name_bn")
  nameEn                         String         @map("name_en")
  defaultLocale                  Locale         @default(bn) @map("default_locale")
  /// Copied into attendance_settings.mode when a tenant is provisioned.
  attendanceMode                 AttendanceMode @default(DAILY) @map("attendance_mode")
  /// The theme an institute of this type gets until its owner picks another.
  defaultTheme                   ThemePreset    @default(SCHOOL) @map("default_theme")
  isActive                       Boolean        @default(true) @map("is_active")
  sortOrder                      Int            @default(0) @map("sort_order")
  defaultGradingSchemeTemplateId String?        @map("default_grading_scheme_template_id") @db.Uuid
  createdAt                      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  defaultGradingSchemeTemplate GradingSchemeTemplate? @relation(fields: [defaultGradingSchemeTemplateId], references: [id], onDelete: SetNull)
  classLevels                  TemplateClassLevel[]
  studyGroups                  TemplateStudyGroup[]
  labels                       TemplateLabel[]
  tenants                      Tenant[]

  @@map("institute_types")
}

model GradingSchemeTemplate {
  id                 String       @id @default(uuid(7)) @db.Uuid
  key                String       @unique
  nameBn             String       @map("name_bn")
  nameEn             String       @map("name_en")
  roundingMode       RoundingMode @default(NONE) @map("rounding_mode")
  /// GPA rules (data, not code): the cap, the 4th subject's bonus threshold (NULL: no bonus),
  /// how the GPA is cut, and whether one failed compulsory subject makes the GPA 0.
  gpaMax             Decimal      @default(5.00) @map("gpa_max") @db.Decimal(3, 2)
  optionalBonusAbove Decimal?     @default(2.00) @map("optional_bonus_above") @db.Decimal(3, 2)
  gpaDecimals        Int          @default(2) @map("gpa_decimals") @db.SmallInt
  gpaRounding        GpaRounding  @default(TRUNCATE) @map("gpa_rounding")
  compulsoryFailZero Boolean      @default(true) @map("compulsory_fail_zero")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  bands          GradeBandTemplate[]
  instituteTypes InstituteType[]
  copies         GradingScheme[]

  @@map("grading_scheme_templates")
}

model GradeBandTemplate {
  id                      String   @id @default(uuid(7)) @db.Uuid
  gradingSchemeTemplateId String   @map("grading_scheme_template_id") @db.Uuid
  /// Inclusive lower bound. A percentage gets the band with the highest min_percent <= it.
  minPercent              Decimal  @map("min_percent") @db.Decimal(5, 2)
  /// Informational upper bound shown to users (e.g. 70–79).
  maxPercent              Decimal  @map("max_percent") @db.Decimal(5, 2)
  letter                  String
  gradePoint              Decimal  @map("grade_point") @db.Decimal(3, 2)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  gradingSchemeTemplate GradingSchemeTemplate @relation(fields: [gradingSchemeTemplateId], references: [id], onDelete: Cascade)

  @@unique([gradingSchemeTemplateId, minPercent])
  @@unique([gradingSchemeTemplateId, letter])
  @@map("grade_band_templates")
}

model TemplateClassLevel {
  id              String   @id @default(uuid(7)) @db.Uuid
  instituteTypeId String   @map("institute_type_id") @db.Uuid
  code            String
  nameBn          String   @map("name_bn")
  nameEn          String   @map("name_en")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  instituteType InstituteType     @relation(fields: [instituteTypeId], references: [id], onDelete: Cascade)
  subjects      TemplateSubject[]
  copies        ClassLevel[]

  @@unique([instituteTypeId, code])
  @@map("template_class_levels")
}

/// e.g. Science / Business Studies / Humanities for NCTB classes 9–10.
model TemplateStudyGroup {
  id              String   @id @default(uuid(7)) @db.Uuid
  instituteTypeId String   @map("institute_type_id") @db.Uuid
  code            String
  nameBn          String   @map("name_bn")
  nameEn          String   @map("name_en")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  instituteType InstituteType     @relation(fields: [instituteTypeId], references: [id], onDelete: Cascade)
  subjects      TemplateSubject[]
  copies        StudyGroup[]

  @@unique([instituteTypeId, code])
  @@map("template_study_groups")
}

model TemplateSubject {
  id                   String   @id @default(uuid(7)) @db.Uuid
  templateClassLevelId String   @map("template_class_level_id") @db.Uuid
  templateStudyGroupId String?  @map("template_study_group_id") @db.Uuid
  code                 String
  nameBn               String   @map("name_bn")
  nameEn               String   @map("name_en")
  /// In the class's elective pool: taken only when chosen, as compulsory or as the 4th subject.
  isOptional           Boolean  @default(false) @map("is_optional")
  passRule             PassRule @default(PER_COMPONENT) @map("pass_rule")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  templateClassLevel TemplateClassLevel         @relation(fields: [templateClassLevelId], references: [id], onDelete: Cascade)
  templateStudyGroup TemplateStudyGroup?        @relation(fields: [templateStudyGroupId], references: [id], onDelete: SetNull)
  copies             Subject[]
  components         TemplateSubjectComponent[]
  passGroups         TemplateSubjectPassGroup[]

  @@unique([templateClassLevelId, code])
  @@map("template_subjects")
}

/// Default exam parts of a template subject (e.g. CQ 70 + MCQ 30), copied into subject_components.
model TemplateSubjectComponent {
  id                String        @id @default(uuid(7)) @db.Uuid
  templateSubjectId String        @map("template_subject_id") @db.Uuid
  key               String
  kind              ComponentKind
  nameBn            String        @map("name_bn")
  nameEn            String        @map("name_en")
  fullMarks         Int           @map("full_marks")
  /// Used when the subject's pass rule is PER_COMPONENT.
  passMarks         Int?          @map("pass_marks")
  sortOrder         Int           @default(0) @map("sort_order")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  templateSubject TemplateSubject    @relation(fields: [templateSubjectId], references: [id], onDelete: Cascade)
  copies          SubjectComponent[]

  @@unique([templateSubjectId, key])
  @@map("template_subject_components")
}

/// Combined pass mark per component kind of a template subject (pass rule COMBINED).
model TemplateSubjectPassGroup {
  id                String        @id @default(uuid(7)) @db.Uuid
  templateSubjectId String        @map("template_subject_id") @db.Uuid
  kind              ComponentKind
  passMarks         Int           @map("pass_marks")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  templateSubject TemplateSubject @relation(fields: [templateSubjectId], references: [id], onDelete: Cascade)

  @@unique([templateSubjectId, kind])
  @@map("template_subject_pass_groups")
}

/// UI labels that differ by institute type, e.g. key `section` → "Batch" (coaching) / "Section" (school).
model TemplateLabel {
  id              String   @id @default(uuid(7)) @db.Uuid
  instituteTypeId String   @map("institute_type_id") @db.Uuid
  key             String
  valueBn         String   @map("value_bn")
  valueEn         String   @map("value_en")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  instituteType InstituteType @relation(fields: [instituteTypeId], references: [id], onDelete: Cascade)

  @@unique([instituteTypeId, key])
  @@map("template_labels")
}

// ───────────────────────────── Global: people ─────────────────────────────

/// A person, global across tenants. Their roles per tenant are memberships.
model User {
  id                String      @id @default(uuid(7)) @db.Uuid
  /// E.164 Bangladeshi mobile, e.g. +8801712345678 (CHECK constraint in SQL).
  phone             String      @unique
  email             String?     @unique
  name              String
  /// Name in Bangla script, shown in the Bangla UI; falls back to `name`.
  nameBn            String?     @map("name_bn")
  passwordHash      String?     @map("password_hash")
  /// When the person last set their password themselves (null: never, or only by the seed).
  passwordChangedAt DateTime?   @map("password_changed_at") @db.Timestamptz(3)
  locale            Locale      @default(bn)
  colorScheme       ColorScheme @default(SYSTEM) @map("color_scheme")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  students    Student[]
  guardians   Guardian[]
  auditLogs   AuditLog[]
  sessions    Session[]

  sectionTeachers        SectionTeacher[]
  sectionSubjectTeachers SectionSubjectTeacher[]
  examClassesPublished   ExamClass[]             @relation("ExamClassPublishedBy")
  examRemarksWritten     ExamCandidate[]         @relation("ExamCandidateRemarksBy")
  examSheetsUpdated      ExamMarkSheet[]         @relation("ExamSheetUpdatedBy")
  examSheetsSubmitted    ExamMarkSheet[]         @relation("ExamSheetSubmittedBy")
  examSheetsLocked       ExamMarkSheet[]         @relation("ExamSheetLockedBy")
  examMarksUpdated       ExamMark[]              @relation("ExamMarkUpdatedBy")

  attendanceSessionsTaken   AttendanceSession[] @relation("AttendanceTakenBy")
  attendanceSessionsUpdated AttendanceSession[] @relation("AttendanceUpdatedBy")
  holidaysCreated           Holiday[]
  studentImports            StudentImport[]
  staffProfiles             StaffProfile[]

  feeConcessionsCreated    FeeConcession[]       @relation("FeeConcessionCreatedBy")
  feeConcessionsEnded      FeeConcession[]       @relation("FeeConcessionEndedBy")
  feeSiblingGroupsCreated  FeeSiblingGroup[]     @relation("FeeSiblingGroupCreatedBy")
  feeSiblingMembersAdded   FeeSiblingMember[]    @relation("FeeSiblingMemberAddedBy")
  feeSiblingMembersRemoved FeeSiblingMember[]    @relation("FeeSiblingMemberRemovedBy")
  feeDuesCancelled         FeeDue[]              @relation("FeeDueCancelledBy")
  feeFineWaiversCreated    FeeFineWaiver[]       @relation("FeeFineWaiverCreatedBy")
  feePaymentsCollected     FeePayment[]          @relation("FeePaymentCollectedBy")
  feePaymentsVoided        FeePayment[]          @relation("FeePaymentVoidedBy")
  feeSubmissionsSubmitted  FeeMobileSubmission[] @relation("FeeSubmissionSubmittedBy")
  feeSubmissionsReviewed   FeeMobileSubmission[] @relation("FeeSubmissionReviewedBy")

  attendanceDevicesCreated AttendanceDevice[]   @relation("AttendanceDeviceCreatedBy")
  attendanceDevicesUpdated AttendanceDevice[]   @relation("AttendanceDeviceUpdatedBy")
  devicePeopleCreated      DevicePerson[]       @relation("DevicePersonCreatedBy")
  devicePeopleUpdated      DevicePerson[]       @relation("DevicePersonUpdatedBy")
  deviceCommandsCreated    DeviceCommand[]      @relation("DeviceCommandCreatedBy")
  devicePunchesReviewed    DevicePunch[]        @relation("DevicePunchReviewedBy")
  deviceSourceIpsTrusted   DeviceSourceIp[]     @relation("DeviceSourceIpTrustedBy")
  staffDaysUpdated         StaffAttendanceDay[] @relation("StaffAttendanceDayUpdatedBy")

  storedFilesCreated StoredFile[] @relation("StoredFileCreatedBy")

  promotionRunsCreated PromotionRun[] @relation("PromotionRunCreatedBy")
  promotionRunsApplied PromotionRun[] @relation("PromotionRunAppliedBy")

  noticesCreated   Notice[]     @relation("NoticeCreatedBy")
  noticesPublished Notice[]     @relation("NoticePublishedBy")
  noticesWithdrawn Notice[]     @relation("NoticeWithdrawnBy")
  noticeReads      NoticeRead[]

  smsBroadcastsCreated   SmsBroadcast[] @relation("SmsBroadcastCreatedBy")
  smsBroadcastsScheduled SmsBroadcast[] @relation("SmsBroadcastScheduledBy")
  smsBroadcastsCancelled SmsBroadcast[] @relation("SmsBroadcastCancelledBy")

  paymentAccountsCredentialsUpdated PaymentGatewayAccount[] @relation("PaymentAccountCredentialsUpdatedBy")
  paymentAccountsTested             PaymentGatewayAccount[] @relation("PaymentAccountTestedBy")
  paymentIntentsPaid                PaymentIntent[]         @relation("PaymentIntentPayer")
  paymentIntentsResolved            PaymentIntent[]         @relation("PaymentIntentResolvedBy")
  paymentSignalReviews              PaymentSignalReview[]   @relation("PaymentSignalReviewResolvedBy")

  @@map("users")
}

// ───────────────────────────── Tenancy ─────────────────────────────

/// An institute. RLS: a tenant can only see its own row (policy on `id`).
model Tenant {
  id              String        @id @default(uuid(7)) @db.Uuid
  slug            String        @unique
  name            String
  instituteTypeId String        @map("institute_type_id") @db.Uuid
  status          TenantStatus  @default(TRIAL)
  timezone        String        @default("Asia/Dhaka")
  defaultLocale   Locale        @default(bn) @map("default_locale")
  /// While SUSPENDED: the status to return to on reactivation (TRIAL or ACTIVE). Platform only.
  suspendedFrom   TenantStatus? @map("suspended_from")
  suspendedAt     DateTime?     @map("suspended_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  instituteType    InstituteType     @relation(fields: [instituteTypeId], references: [id], onDelete: Restrict)
  modules          TenantModule[]
  labels           TenantLabel[]
  branches         Branch[]
  academicYears    AcademicYear[]
  shifts           Shift[]
  gradingSchemes   GradingScheme[]
  gradeBands       GradeBand[]
  classLevels      ClassLevel[]
  studyGroups      StudyGroup[]
  subjects         Subject[]
  sections         Section[]
  memberships      Membership[]
  students         Student[]
  guardians        Guardian[]
  studentGuardians StudentGuardian[]
  enrolments       Enrolment[]
  auditLogs        AuditLog[]
  sessions         Session[]

  attendanceSettings  AttendanceSettings?
  holidays            Holiday[]
  studentSettings     StudentSettings?
  appearanceSettings  AppearanceSettings?
  studentCodeCounters StudentCodeCounter[]
  sectionTeachers     SectionTeacher[]
  attendanceSessions  AttendanceSession[]
  attendanceRecords   AttendanceRecord[]
  smsLogs             SmsLog[]
  studentImports      StudentImport[]
  staffProfiles       StaffProfile[]
  subscription        TenantSubscription?
  onboarding          OnboardingProgress?
  invoices            PlatformInvoice[]
  invoiceLines        PlatformInvoiceLine[]
  payments            PlatformPayment[]

  feeSettings             FeeSettings?
  feeHeads                FeeHead[]
  feeTerms                FeeTerm[]
  feeAmounts              FeeAmount[]
  feeConcessions          FeeConcession[]
  feeSiblingGroups        FeeSiblingGroup[]
  feeSiblingMembers       FeeSiblingMember[]
  feeDues                 FeeDue[]
  feeFineWaivers          FeeFineWaiver[]
  feeReceiptCounters      FeeReceiptCounter[]
  feePayments             FeePayment[]
  feePaymentAllocations   FeePaymentAllocation[]
  feeMobileAccounts       FeeMobileAccount[]
  feeMobileSubmissions    FeeMobileSubmission[]
  feeMobileSubmissionDues FeeMobileSubmissionDue[]

  subjectComponents      SubjectComponent[]
  subjectPassGroups      SubjectPassGroup[]
  sectionSubjectTeachers SectionSubjectTeacher[]
  studentSubjectChoices  StudentSubjectChoice[]
  examRooms              ExamRoom[]
  exams                  Exam[]
  examClasses            ExamClass[]
  examSubjects           ExamSubject[]
  examSubjectComponents  ExamSubjectComponent[]
  examSubjectPassGroups  ExamSubjectPassGroup[]
  examCandidates         ExamCandidate[]
  examMarkSheets         ExamMarkSheet[]
  examMarks              ExamMark[]
  examResults            ExamResult[]

  attendanceDevices   AttendanceDevice[]
  devicePeople        DevicePerson[]
  deviceCommands      DeviceCommand[]
  devicePunches       DevicePunch[]
  deviceSourceIps     DeviceSourceIp[]
  staffAttendanceDays StaffAttendanceDay[]

  storedFiles StoredFile[]

  admissionCycles            AdmissionCycle[]
  admissionCycleClasses      AdmissionCycleClass[]
  admissionApplications      AdmissionApplication[]
  admissionApplicationPhotos AdmissionApplicationPhoto[]
  admissionCounters          AdmissionCounter[]
  storedFileUsage            StoredFileUsage?
  instituteProfile           InstituteProfile?

  promotionRuns        PromotionRun[]
  promotionRunStudents PromotionRunStudent[]

  notices       Notice[]
  noticeTargets NoticeTarget[]
  noticeReads   NoticeRead[]

  smsBroadcasts       SmsBroadcast[]
  smsBroadcastTargets SmsBroadcastTarget[]

  paymentGatewayAccounts PaymentGatewayAccount[]
  paymentIntents         PaymentIntent[]
  paymentIntentDues      PaymentIntentDue[]
  paymentGatewayEvents   PaymentGatewayEvent[]
